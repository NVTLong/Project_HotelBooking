@using Project_HotelBooking.Enums
@model IEnumerable<Project_HotelBooking.Application.DTOs.BookingDetail.BookingDetailDto>

@{
    ViewData["Title"] = "Booking Detail";
}
@{
    var status = (BookingStatus)ViewBag.Status;
}
<div class="admin-page-header">
    <div class="d-flex align-items-center">
        <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="btn btn-link text-decoration-none text-muted p-0 me-3">
            <i class="bi bi-arrow-left fs-4"></i>
        </a>
        <h2 class="admin-page-title">Chi tiết Booking</h2>
    </div>
    <div class="text-muted small">Cập nhật: @DateTime.Now.ToString("HH:mm, dd/MM/yyyy")</div>
</div>

    <div class="card card-premium shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="m-0 fw-bold">Thông tin đặt phòng</h4>
            @if (status == BookingStatus.CheckedIn)
            {
                <span class="status-badge badge-active"><i class="bi bi-check-circle me-1"></i> Đã Check-in</span>
            }
            else if (status == BookingStatus.CheckedOut)
            {
                <span class="status-badge badge-inactive"><i class="bi bi-door-closed me-1"></i> Đã Check-out</span>
            }
            else
            {
                <span class="status-badge status-reserved"><i class="bi bi-clock me-1"></i> Đã xác nhận</span>
            }
        </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="info-group">
                            <span class="info-label">Mã Booking</span>
                            <span class="info-value text-primary font-monospace">@ViewBag.BookingCode</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-group">
                            <span class="info-label">Khách hàng</span>
                            <span class="info-value">@ViewBag.CustomerName</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-group">
                            <span class="info-label">Check-in</span>
                            <span class="info-value">@(((DateTime)ViewBag.CheckIn).ToString("dd/MM/yyyy"))</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-group">
                            <span class="info-label">Check-out</span>
                            <span class="info-value">@(((DateTime)ViewBag.CheckOut).ToString("dd/MM/yyyy"))</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="mb-4">
            @if (status != BookingStatus.CheckedOut)
            {
                <button class="btn btn-primary btn-lg rounded-pill px-4 me-2 shadow-sm" id="btnAddRoom">
                    <i class="bi bi-plus-lg me-2"></i>Thêm Phòng
                </button>
                @if (status == BookingStatus.CheckedIn)
                {
                    <button class="btn btn-success btn-lg rounded-pill px-4 shadow-sm" onclick="checkoutBooking(@ViewBag.BookingId)">
                        <i class="bi bi-box-arrow-right me-2"></i>Check-out Toàn bộ
                    </button>
                }
            }
        </div>

        <!-- Rooms Table -->
        <div class="card card-premium shadow-sm mb-4">
            <div class="card-header bg-white">
                <h4 class="m-0 fw-bold">Danh sách phòng</h4>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Phòng</th>
                            <th>Giá / Đêm</th>
                            <th class="text-center">Số đêm</th>
                            <th class="text-center">Số khách</th>
                            <th class="text-end">Thành tiền</th>
                            @if (status != BookingStatus.CheckedOut)
                            {
                                <th class="text-center">Thêm dịch vụ</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.RoomNumber</td>
                                <td>@item.PricePerNight.ToString("N0") <small class="text-muted">VNĐ</small></td>
                                <td class="text-center">@item.NumberOfNights</td>
                                <td class="text-center">@item.NumberOfGuests</td>
                                <td class="text-end fw-bold text-primary">@item.SubTotal.ToString("N0") <small>VNĐ</small></td>
                                @if (status != BookingStatus.CheckedOut)
                                {
                                    <td class="text-center">
                                        <i class="bi bi-plus-lg text-success action-icon" onclick="openAddService(@item.Id)" title="Thêm dịch vụ"></i>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Services Section -->
        <div class="card card-premium shadow-sm">
            <div class="card-header bg-white">
                <h4 class="m-0 fw-bold">Dịch vụ đã sử dụng</h4>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Dịch vụ</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Tổng tiền</th>
                            @if (status != BookingStatus.CheckedOut)
                            {
                                <th class="text-center">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody id="serviceTable">
                        @foreach (var detail in Model)
                        {
                            if (detail.HotelServices != null)
                            {
                                foreach (var s in detail.HotelServices)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@s.ServiceName</div>
                                            <small class="text-muted">Phòng: @detail.RoomNumber</small>
                                        </td>
                                        <td class="text-center qty">@s.Quantity</td>
                                        <td class="text-end">@s.Price.ToString("N0") <small>VNĐ</small></td>
                                        <td class="text-end fw-bold text-success subTotal">@((s.Quantity * s.Price).ToString("N0")) <small>VNĐ</small></td>
                                        @if (status != BookingStatus.CheckedOut)
                                        {
                                            <td class="text-center">
                                                <i class="bi bi-pencil-square text-warning action-icon me-2" onclick="openEdit(@s.Id)" title="Sửa"></i>
                                                <i class="bi bi-trash text-danger action-icon btn-delete" data-id="@s.Id" title="Xóa"></i>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add Room -->
<div class="modal fade" id="bookingDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm phòng vào Booking</h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>
            <div class="modal-body">
                <input type="hidden" id="BookingId" value="@ViewBag.BookingId" />
                <div class="row mb-3">
                    <div class="col-md-6 mb-3">
                        <label class="info-label">Loại phòng</label>
                        <select id="RoomTypeId" class="form-control">
                            <option value="">-- Chọn loại phòng --</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="info-label">Phòng trống</label>
                        <select id="RoomId" class="form-control">
                            <option value="">-- Chọn phòng --</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="info-label">Số đêm</label>
                        <input type="number" id="NumberOfNights" class="form-control" value="1">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="info-label">Số khách</label>
                        <input type="number" id="NumberOfGuests" class="form-control" value="1">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="info-label">Giá / Đêm</label>
                        <input type="text" id="PricePerNight" class="form-control" readonly>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary rounded-pill px-4" id="btnSave">Lưu thông tin</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add Service -->
<div class="modal fade" id="addServiceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm dịch vụ cho phòng</h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>
            <div class="modal-body">
                <input type="hidden" id="BookingDetailId" />
                <div class="mb-4">
                    <label class="info-label">Tìm kiếm dịch vụ</label>
                    <select id="serviceSelect" style="width:100%" class="form-control"></select>
                </div>
                <div id="selectedServices" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-success rounded-pill px-4" onclick="saveMultipleService()">Cập nhật dịch vụ</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edit Service -->
<div class="modal fade" id="editServiceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật số lượng dịch vụ</h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editServiceId" />
                <div class="mb-3">
                    <label class="info-label">Tên dịch vụ</label>
                    <input type="text" id="editServiceName" class="form-control" readonly style="background-color: #f8fafc;">
                </div>
                <div class="mb-3">
                    <label class="info-label">Số lượng</label>
                    <div class="d-flex align-items-center">
                        <button class="btn btn-outline-secondary rounded-circle p-0" style="width: 35px; height: 35px;" onclick="changeEditQty(-1)">
                            <i class="bi bi-dash fs-4"></i>
                        </button>
                        <input type="number" id="editServiceQty" class="form-control mx-3 text-center fw-bold" style="width: 100px; height: 45px; font-size: 1.1rem;">
                        <button class="btn btn-outline-secondary rounded-circle p-0" style="width: 35px; height: 35px;" onclick="changeEditQty(1)">
                            <i class="bi bi-plus fs-4"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary rounded-pill px-4" onclick="updateServiceItem()">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        let currentBookingDetailId = 0;

        // ================= ROOM =================
        $("#btnAddRoom").click(function () {
            loadRoomTypes();
            var modal = new bootstrap.Modal(document.getElementById('bookingDetailModal'));
            modal.show();
        });

        function loadRoomTypes() {
            $.get("/Admin/Rooms/GetRoomTypes", function (res) {
                var select = $("#RoomTypeId");
                select.empty();
                select.append(new Option("-- Chọn loại phòng --", ""));

                res.resources.forEach(r => {
                    select.append(new Option(r.text, r.value));
                });
            });
        }

        $("#RoomTypeId").change(function () {
            var roomTypeId = $(this).val();

            if (!roomTypeId) {
                $("#RoomId").empty().append(new Option("-- Chọn phòng --", ""));
                return;
            }

            loadRooms(roomTypeId);
        });

        function loadRooms(roomTypeId) {
            $.get("/Admin/Rooms/GetAvailableRoomsByType",
                { roomTypeId: roomTypeId },
                function (res) {
                    var select = $("#RoomId");
                    select.empty().append(new Option("-- Chọn phòng --", ""));

                    res.resources.forEach(r => {
                        var option = new Option(
                            r.text + " - " + r.price.toLocaleString() + " VND",
                            r.value
                        );

                        $(option).attr("data-price", r.price);
                        select.append(option);
                    });
                });
        }

        $("#RoomId").change(function () {
            var price = $(this).find(":selected").data("price");
            $("#PricePerNight").val(price ? price.toLocaleString() : "");
        });

        $("#btnSave").click(function () {
            var payload = {
                BookingId: $("#BookingId").val(),
                RoomId: $("#RoomId").val(),
                PricePerNight: $("#PricePerNight").val() ? parseFloat($("#PricePerNight").val().replace(/,/g, '')) : 0,
                NumberOfNights: $("#NumberOfNights").val(),
                NumberOfGuests: $("#NumberOfGuests").val()
            };

            if (!payload.RoomId) {
                Swal.fire("Thông báo", "Vui lòng chọn phòng", "warning");
                return;
            }

            $.ajax({
                url: "/Admin/BookingDetails/Create",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function () {
                    Swal.fire("Thành công", "Đã thêm phòng vào booking", "success").then(() => location.reload());
                },
                error: function() {
                    Swal.fire("Lỗi", "Không thể thêm phòng", "error");
                }
            });
        });

        // ================= SERVICE =================

        let selectedServices = [];

        function openAddService(bookingDetailId) {
            currentBookingDetailId = bookingDetailId;
            $('#BookingDetailId').val(bookingDetailId);
            selectedServices = [];
            renderSelectedServices();
            var modal = new bootstrap.Modal(document.getElementById('addServiceModal'));
            modal.show();
        }

        $('#serviceSelect').select2({
            placeholder: "Tìm dịch vụ...",
            dropdownParent: $('#addServiceModal'),
            ajax: {
                url: '/Admin/BookingHotelService/GetAll',
                dataType: 'json',
                delay: 250,
                processResults: function (res) {
                    return {
                        results: res.resources.map(s => ({
                            id: s.value,
                            text: s.text + " (" + s.unit + ")",
                            price: s.price,
                            unit: s.unit,
                            isOneTime: s.isOneTime
                        }))
                    };
                }
            }
        });

        $('#serviceSelect').on('select2:select', function (e) {
            let data = e.params.data;
            let exist = selectedServices.find(x => x.serviceId == data.id);

            if (exist) {
                if (exist.isOneTime) {
                    Swal.fire("Thông báo", "Dịch vụ này chỉ chọn 1 lần", "info");
                    return;
                }
                exist.quantity += 1;
            } else {
                selectedServices.push({
                    serviceId: data.id,
                    name: data.text,
                    price: data.price,
                    quantity: 1,
                    isOneTime: data.isOneTime,
                    unit: data.unit
                });
            }

            renderSelectedServices();
            $('#serviceSelect').val(null).trigger('change');
        });

        function renderSelectedServices() {
            let html = "";
            selectedServices.forEach(s => {
                let qtyControls = s.isOneTime 
                    ? `<span class="mx-3 fw-bold text-muted small">Số lượng: 1</span>` 
                    : `<button class="btn btn-sm btn-outline-secondary rounded-circle d-flex justify-content-center align-items-center p-0"
                               style="width: 24px; height: 24px;"
                               onclick="changeQty(${s.serviceId}, -1)">
                               <i class="bi bi-dash"></i>
                       </button>
                       <input type="text" value="${s.quantity}" class="form-control mx-2 text-center" style="width:40px; height: 24px; font-size: 0.8rem; padding: 0;" readonly />
                       <button class="btn btn-sm btn-outline-secondary rounded-circle d-flex justify-content-center align-items-center p-0"
                               style="width: 24px; height: 24px;"
                               onclick="changeQty(${s.serviceId}, 1)">
                               <i class="bi bi-plus"></i>
                       </button>`;

                html += `
                    <div class="d-flex justify-content-between align-items-center mb-2 border p-3 rounded-4 bg-white shadow-sm">
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark small">${s.name}</div>
                            <div class="text-primary fw-bold" style="font-size: 0.85rem;">${s.price.toLocaleString()} VNĐ</div>
                        </div>
                        <div class="d-flex align-items-center">
                            ${qtyControls}
                            <button class="btn btn-link text-danger ms-3 p-0" onclick="removeService(${s.serviceId})">
                                <i class="bi bi-x-circle fs-5"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            $("#selectedServices").html(html || '<p class="text-center text-muted py-3">Chưa có dịch vụ nào được chọn</p>');
        }

        function changeQty(serviceId, delta) {
            let item = selectedServices.find(x => x.serviceId == serviceId);
            if (!item) return;
            if (item.isOneTime && delta > 0) return;
            item.quantity += delta;
            if (item.quantity <= 0) {
                selectedServices = selectedServices.filter(x => x.serviceId != serviceId);
            }
            renderSelectedServices();
        }

        function removeService(serviceId) {
            selectedServices = selectedServices.filter(x => x.serviceId != serviceId);
            renderSelectedServices();
        }

        function saveMultipleService() {
            if (selectedServices.length === 0) {
                Swal.fire("Lưu ý", "Vui lòng chọn ít nhất một dịch vụ", "warning");
                return;
            }

            $.ajax({
                url: '/Admin/BookingHotelService/CreateMultiple',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    bookingDetailId: currentBookingDetailId,
                    items: selectedServices
                }),
                success: function (res) {
                    if (res.status == 200) {
                        Swal.fire("Thành công", "Đã thêm dịch vụ vào phòng", "success").then(() => location.reload());
                    } else {
                        Swal.fire("Lỗi", res.message || "Không thể lưu dịch vụ", "error");
                    }
                }
            });
        }

        function checkoutBooking(bookingId) {
            Swal.fire({
                title: "Xác nhận Check-out",
                text: "Bạn có chắc muốn check-out toàn bộ booking này không? Tình trạng phòng sẽ được cập nhật.",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#16a34a",
                cancelButtonColor: "#64748b",
                confirmButtonText: "Đồng ý",
                cancelButtonText: "Hủy"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Admin/Bookings/CheckOut', { id: bookingId }, function (res) {
                        if (res.success) {
                            Swal.fire("Thành công", res.message, "success").then(() => location.reload());
                        } else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    });
                }
            });
        }

        // ===== EDIT / DELETE SERVICE =====
        function openEdit(id) {
            $.get('/Admin/BookingHotelService/get-by-id/' + id, function(res) {
                if (res.status == 200) {
                    $('#editServiceId').val(res.data.id);
                    $('#editServiceName').val(res.data.serviceName);
                    $('#editServiceQty').val(res.data.quantity);
                    
                    var modal = new bootstrap.Modal(document.getElementById('editServiceModal'));
                    modal.show();
                }
            });
        }

        function changeEditQty(delta) {
            let cur = parseInt($('#editServiceQty').val()) || 0;
            let next = cur + delta;
            if (next < 1) next = 1;
            $('#editServiceQty').val(next);
        }

        function updateServiceItem() {
            let id = $('#editServiceId').val();
            let qty = $('#editServiceQty').val();

            $.ajax({
                url: '/Admin/BookingHotelService/update',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ id: parseInt(id), quantity: parseInt(qty) }),
                success: function(res) {
                    if (res.status == 200) {
                        Swal.fire("Thành công", "Đã cập nhật dịch vụ", "success").then(() => location.reload());
                    }
                }
            });
        }

        $(document).on("click", ".btn-delete", function () {
            const id = $(this).data("id");
            Swal.fire({
                title: "Xác nhận xóa?",
                text: "Dịch vụ này sẽ bị xoá khỏi danh sách thanh toán.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#ef4444",
                confirmButtonText: "Xóa ngay",
                cancelButtonText: "Hủy"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/BookingHotelService/delete/' + id,
                        type: 'POST', // Matches [HttpPost("delete/{id}")]
                        success: function (res) {
                            if (res.success) {
                                Swal.fire("Đã xóa", "Dịch vụ đã được loại bỏ", "success").then(() => location.reload());
                            } else {
                                Swal.fire("Lỗi", res.message || "Không thể xóa dịch vụ này", "error");
                            }
                        },
                        error: function() {
                            Swal.fire("Lỗi", "Không thể xóa dịch vụ này", "error");
                        }
                    });
                }
            });
        });

    </script>
}
