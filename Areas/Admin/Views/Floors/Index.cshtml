@model IEnumerable<Project_HotelBooking.Application.DTOs.Floor.FloorDto>

@{
    ViewData["Title"] = "Quản lý Tầng";
}

<div class="admin-page-header">
    <h2 class="admin-page-title">Quản lý Tầng</h2>
    <button type="button" class="btn btn-primary" id="btnAddNew">
        <i class="bi bi-plus-lg me-2"></i> Thêm mới
    </button>
</div>

<div class="card card-premium shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tên tầng</th>
                        <th class="text-center">Số tầng</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.FloorName</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark rounded-pill px-3">@item.FloorNumber</span>
                            </td>
                            <td class="text-end pe-4">
                                <i class="bi bi-pencil-square text-warning me-3 action-icon" onclick="openEdit(@item.Id)" title="Sửa"></i>
                                <i class="bi bi-trash text-danger action-icon btn-delete" data-id="@item.Id" title="Xóa"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="floorModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm tầng</h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>
            <div class="modal-body">
                <input type="hidden" id="Id" name="Id" />
                <div class="mb-3">
                    <label>Tên tầng</label>
                    <input type="text" id="FloorName" name="FloorName" class="form-control" placeholder="Ví dụ: Tầng 1" />
                </div>
                <div class="mb-3">
                    <label>Số tầng (Thứ tự)</label>
                    <input type="number" id="FloorNumber" name="FloorNumber" class="form-control" placeholder="Ví dụ: 1" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnSaveRoom" class="btn btn-primary">Lưu thông tin</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#btnAddNew").on("click", function () {
                $("#Id").val(0);
                $("#FloorName").val("");
                $("#FloorNumber").val("");
                $("#modalTitle").text("Thêm tầng");
                new bootstrap.Modal(document.getElementById('floorModal')).show();
            });

            $("#btnSaveRoom").on("click", function () {
                var id = Number($("#Id").val());
                var payload = {
                    Id: id,
                    FloorName: $("#FloorName").val(),
                    FloorNumber: $("#FloorNumber").val(),
                };
                var isUpdate = id > 0;

                $.ajax({
                    url: isUpdate ? "/Admin/Floors/Update" : "/Admin/Floors/Create",
                    type: isUpdate ? "PUT" : "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.status === 200) {
                            Swal.fire("Thành công!", isUpdate ? "Cập nhật thành công" : "Thêm thành công", "success")
                                .then(() => location.reload());
                        } else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Lỗi", "Có lỗi xảy ra", "error");
                    }
                });
            });

            $(document).on("click", ".btn-delete", function () {
                var id = $(this).data("id");
                Swal.fire({
                    title: "Xác nhận xóa?",
                    text: "Tất cả phòng thuộc tầng này có thể bị ảnh hưởng!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#ef4444",
                    confirmButtonText: "Xóa ngay",
                    cancelButtonText: "Hủy"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "/Admin/Floors/Delete/",
                            type: "DELETE",
                            data: { id: id },
                            success: function () {
                                Swal.fire("Đã xóa!", "Tầng đã được loại bỏ.", "success").then(() => location.reload());
                            }
                        });
                    }
                });
            });
        });

        function openEdit(id) {
            $.get("/Admin/Floors/GetById/" + id, function (res) {
                $("#Id").val(res.id);
                $("#FloorName").val(res.floorName);
                $("#FloorNumber").val(res.floorNumber);
                $("#modalTitle").text("Cập nhật tầng");
                new bootstrap.Modal(document.getElementById('floorModal')).show();
            });
        }
    </script>
}