@using Project_HotelBooking.Enums
@using Project_HotelBooking.Enums.Helper
@model IEnumerable<Project_HotelBooking.Application.DTOs.Amenity.AmenityDto>

@{
    ViewData["Title"] = "Quản lý Tiện nghi";
}

<div class="admin-page-header">
    <h2 class="admin-page-title">Quản lý Tiện nghi</h2>
    <button type="button" class="btn btn-primary" id="btnAddNew">
        <i class="bi bi-plus-lg me-2"></i> Thêm mới
    </button>
</div>

<div class="card card-premium shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tên tiện nghi</th>
                        <th>Mô tả</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Name</td>
                            <td class="text-muted">@item.Description</td>
                            <td class="text-end pe-4">
                                <i class="bi bi-pencil-square text-warning me-3 action-icon" onclick="openEdit(@item.Id)" title="Sửa"></i>
                                <i class="bi bi-trash text-danger action-icon btn-delete" data-id="@item.Id" title="Xóa"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="amenityModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm tiện nghi</h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>
            <div class="modal-body">
                <input type="hidden" id="Id" name="Id" />
                <div class="mb-3">
                    <label>Tên tiện nghi</label>
                    <input type="text" id="Name" name="Name" class="form-control" placeholder="Nhập tên tiện nghi..." />
                </div>
                <div class="mb-3">
                    <label>Mô tả</label>
                    <textarea id="Description" name="Description" class="form-control" rows="3" placeholder="Mô tả ngắn gọn..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnSave" class="btn btn-primary">Lưu thông tin</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#btnAddNew").on("click", function () {
                $("#Id").val(0);
                $("#Name").val("");
                $("#Description").val("");
                $("#modalTitle").text("Thêm tiện nghi");
                new bootstrap.Modal(document.getElementById('amenityModal')).show();
            });

            $("#btnSave").on("click", function () {
                var id = Number($("#Id").val());
                var payload = {
                    Id: id,
                    Name: $("#Name").val(),
                    Description: $("#Description").val()
                };
                var isUpdate = id > 0;

                $.ajax({
                    url: isUpdate ? "/Admin/Amenities/Update" : "/Admin/Amenities/Create",
                    type: isUpdate ? "PUT" : "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.status === 200) {
                            Swal.fire("Thành công!", isUpdate ? "Cập nhật thành công" : "Thêm thành công", "success")
                                .then(() => location.reload());
                        } else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Lỗi", "Có lỗi xảy ra", "error");
                    }
                });
            });

            $(document).on("click", ".btn-delete", function () {
                var id = $(this).data("id");
                Swal.fire({
                    title: "Xác nhận xóa?",
                    text: "Dữ liệu sẽ không thể khôi phục sau khi xóa!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#ef4444",
                    confirmButtonText: "Xóa ngay",
                    cancelButtonText: "Hủy"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "/Admin/Amenities/Delete/",
                            type: "DELETE",
                            data: { id: id },
                            success: function () {
                                Swal.fire("Đã xóa!", "Dữ liệu đã được loại bỏ.", "success").then(() => location.reload());
                            }
                        });
                    }
                });
            });
        });

        function openEdit(id) {
            $.get("/Admin/Amenities/GetById/" + id, function (res) {
                $("#Id").val(res.id);
                $("#Name").val(res.name);
                $("#Description").val(res.description);
                $("#modalTitle").text("Cập nhật tiện nghi");
                new bootstrap.Modal(document.getElementById('amenityModal')).show();
            });
        }
    </script>
}