@using Project_HotelBooking.Enums
@using Project_HotelBooking.Enums.Helper
@model IEnumerable<Project_HotelBooking.Application.DTOs.Amenity.AmenityDto>

@{
    ViewData["Title"] = "Index";
}

<button type="button" class="btn btn-primary me-2" id="btnAddNew">
    <span class="svg-icon svg-icon svg-icon-1 svg_plus p-0"></span> Thêm mới
</button>
<div class="table-scroll mt-2">
    <table class="table table-bordered">
        <thead>
            <tr class="text-center">
                <th>Tên dịch vụ</th>
                <th>Mô tả</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">@item.Name</td>
                    <td class="text-center">@item.Description</td>
                    <td class="text-center">

                        <i class="bi bi-pencil-square fs-3 text-warning me-3 action-icon btn-edit"
                           onclick="openEdit(@item.Id)"
                           title="Edit"></i>

                        @* <i class="bi bi-eye-fill fs-3 text-info me-3 action-icon btn-detail"
                           data-id="@item.Id"
                           title="Details"></i> *@

                        <i class="bi bi-trash fs-3 text-danger action-icon btn-delete"
                           data-id="@item.Id"
                           title="Delete"></i>

                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="amenityModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>

            <div class="modal-body">

                <!-- Hidden Id để phân biệt Create / Edit -->
                <input type="hidden" id="Id" name="Id" />

                    <!-- Tên dịch vụ -->
                    <div class="col-12 mb-3">
                        <label>Tên dịch vụ</label>
                        <input type="text" id="Name" name="Name" class="form-control" />
                    </div>

                    <!-- Mô tả -->
                    <div class="col-12 mb-3">
                        <label>Mô tả</label>
                        <textarea id="Description" name="Description" class="form-control"></textarea>
                    </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" id="btnSave" class="btn btn-primary">Lưu</button>
            </div>

        </div>
    </div>
</div>

<!-- JS -->
@section Scripts {
    <script>
            $(document).ready(function () {

            // ===== CREATE =====
            $("#btnAddNew").on("click", function () {

                $("#Id").val(0);
                $("#Name").val("");
                $("#Description").val("");

                $("#modalTitle").text("Thêm dịch vụ");

                var modal = new bootstrap.Modal(document.getElementById('amenityModal'));
                modal.show();
            });

            // ===== SAVE =====
            $("#btnSave").on("click", function () {

                var id = Number($("#Id").val());

                var payload = {
                    Id: id,
                    Name: $("#Name").val(),
                    Description: $("#Description").val()
                };

                var isUpdate = id > 0;

                $.ajax({
                    url: isUpdate
                        ? "/Admin/Amenities/Update"
                        : "/Admin/Amenities/Create",

                    type: isUpdate ? "PUT" : "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),

                    success: function (res) {

                        if (res.status === 200) {

                            bootstrap.Modal.getInstance(document.getElementById('amenityModal')).hide();

                            Swal.fire({
                                icon: "success",
                                title: "Thành công!",
                                text: isUpdate ? "Cập nhật thành công" : "Thêm thành công"
                            }).then(() => location.reload());
                        }
                        else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Lỗi", "Có lỗi xảy ra", "error");
                    }
                });
            });

        });

               // ===== EDIT =====
        function openEdit(id) {

            $.get("/Admin/Amenities/GetById/" + id, function (res) {

                $("#Id").val(res.id);
                $("#Name").val(res.name);
                $("#Description").val(res.description);

                $("#modalTitle").text("Cập nhật dịch vụ");

                var modal = new bootstrap.Modal(document.getElementById('amenityModal'));
                modal.show();
            });
        }

        // ===== DELETE =====
            $(document).on("click", ".btn-delete", function () {
            var id = $(this).data("id");

            Swal.fire({
                title: "Bạn chắc chắn?",
                text: "Không thể hoàn tác!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Xóa",
                cancelButtonText: "Hủy"
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: "/Admin/Amenities/Delete/",
                        type: "DELETE",
                        data : {id : id},
                        success: function () {

                            Swal.fire("Đã xóa!", "", "success")
                                .then(() => location.reload());
                        }
                    });

                }
            });
        });

        // ===== LOAD ROOM TYPE =====
        function loadRoomTypeDropdown(selectedValue = null) {

            const select = $("#RoomTypeId");
            select.empty();
            select.append('<option value="">Chọn loại phòng</option>');

            $.get("/Admin/RoomTypes/GetRoomTypes", function (res) {

                if (res.status === 200 && res.resources) {

                    res.resources.forEach(o => {
                        select.append(new Option(o.text, o.value));
                    });

                    if (selectedValue !== null) {
                        select.val(selectedValue).trigger('change.select2');
                    }
                }
            });
        }
        // ===== LOAD FLOOR =====
        function loadFloorDropdown(selectedValue = null) {

            const select = $("#FloorId");
            select.empty();
            select.append('<option value="">Chọn tầng</option>');

            $.get("/Admin/Floors/GetFloors", function (res) {

                if (res.status === 200 && res.resources) {

                    res.resources.forEach(o => {
                        select.append(new Option(o.text, o.value));
                    });

                    if (selectedValue !== null) {
                        select.val(selectedValue).trigger('change.select2');
                    }
                }
            });
        }

    </script>
}
<style>
    .action-icon {
        font-size: 24px;
        padding: 6px;
        border-radius: 6px;
        transition: 0.2s;
    }

        .action-icon:hover {
            filter: brightness(70%);
        }

    /* IsActive*/
    .switch {
        position: relative;
        display: inline-block;
        width: 55px;
        height: 28px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #ccc;
        border-radius: 30px;
        transition: 0.3s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            border-radius: 50%;
            transition: 0.3s;
        }

    input:checked + .slider {
        background-color: #7c3aed;
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

    /* CSS IsActive */
    .status-active {
        background-color: #e8f7ee;
        color: #1e7e34;
        border: 1px solid #28a745;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .status-inactive {
        background-color: #fdeaea;
        color: #c82333;
        border: 1px solid #dc3545;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    /* SELECT2 & INPUT STANDARD */
    .form-control {
        border: 1px solid #ced4da !important;
        cursor: text;
    }

    /* SELECT2 */
    /* Fix Select2 height giống Bootstrap */
    #amenityModal .select2-container .select2-selection--single {
        height: 46px !important;
        padding: 6px 12px;
        border: 1px solid #ced4da !important;
        border-radius: 6px;
    }

    #amenityModal .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 34px;
    }

    #amenityModal .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 46px;
    }

    /* CSS Status */
    .status-available {
        background-color: #e8f7ee;
        color: #1e7e34;
        border: 1px solid #28a745;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .status-occupied {
        background-color: #fdeaea;
        color: #c82333;
        border: 1px solid #dc3545;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .status-maintenance {
        background-color: #fff8e1;
        color: #856404;
        border: 1px solid #ffc107;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .status-cleaning {
        background-color: #e7f6fb;
        color: #0c5460;
        border: 1px solid #17a2b8;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

</style>