@using Project_HotelBooking.Enums
@using Project_HotelBooking.Enums.Helper
@model IEnumerable<Project_HotelBooking.Application.DTOs.Room.RoomDto>

@{
    ViewData["Title"] = "Index";
}

<div class="admin-page-header">
    <h2 class="admin-page-title">Quản lý Phòng</h2>
    <button type="button" class="btn btn-primary" id="btnAddNew">
        <i class="bi bi-plus-lg me-2"></i> Thêm mới
    </button>
</div>

<div class="card card-premium shadow-sm mt-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Số phòng</th>
                        <th class="text-center">Tầng</th>
                        <th class="text-center">Loại phòng</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Tình trạng</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.RoomNumber</td>
                            <td class="text-center text-muted">@item.FloorName</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark rounded-pill px-3">@item.RoomTypeName</span>
                            </td>
                            <td class="text-center">
                                <span class ="status-badge status-@item.Status.ToString().ToLower()">
                                    @EnumHelper.GetDisplayName(item.Status)
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="status-badge badge-active">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-inactive">Dừng hoạt động</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <i class="bi bi-pencil-square text-warning me-3 action-icon btn-edit" onclick="openEdit(@item.Id)" title="Edit"></i>
                                <i class="bi bi-trash text-danger action-icon btn-delete" data-id="@item.Id" title="Delete"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="roomModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>

            <div class="modal-body">

                <!-- Hidden Id để phân biệt Create / Edit -->
                <input type="hidden" id="Id" name="Id" />

                <div class="row mb-3">

                    <!-- Tên phòng -->
                    <div class="col-6">
                        <label>Số phòng</label>
                        <input type="text" id="RoomNumber" name="RoomNumber" class="form-control" />
                    </div>

                    <!-- Tầng -->
                    <div class="col-6">
                        <label>Tầng</label>
                        <select id="FloorId" name="FloorId" class="form-control">
                        </select>
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-6">
                        <label>Loại phòng</label>
                        <select id="RoomTypeId" name="RoomTypeId" class="form-control">
                        </select>
                    </div>

                    <div class="col-6">
                        <label>Tiện nghi</label>
                        <select id="amenityList" class="form-control" multiple></select>
                    </div>
                </div>               
                    
                <div class="row mb-3">
                    <!-- Field Ẩn khi Create -->
                    <div class="col-6 updateFields" style="display:none">
                        <label>Trạng thái</label>
                    <select id="Status" name="Status" class="form-control">
                            @foreach (RoomStatus status in Enum.GetValues(typeof(RoomStatus)))
                            {
                                <option value="@((int)status)">
                                    @status.GetDisplayName()
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-6 updateFields" style="display:none">
                        <label class="d-block mb-2">Hoạt động</label>

                        <label class="switch">
                            <input type="checkbox"
                                   id="IsActive"
                                   name="IsActive"
                                   value="true">
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <label>Ảnh phòng (Tối đa 5 ảnh)</label>
                        <input type="file" id="RoomImages" name="Images" class="form-control" multiple accept="image/*" />
                        <div id="imagePreview" class="mt-2 d-flex flex-wrap gap-2"></div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" id="btnSave" class="btn btn-primary">Lưu</button>
            </div>

        </div>
    </div>
</div>

<!-- JS -->
@section Scripts {
    <script>
            $(document).ready(function () {

            // ===== INIT SELECT2 =====
            $('#RoomTypeId').select2({
                dropdownParent: $('#roomModal'),
                width: '100%',
                allowClear: true,
                minimumResultsForSearch: 0
            });
            $('#FloorId').select2({
                dropdownParent: $('#roomModal'),
                width: '100%',
                allowClear: true,
                minimumResultsForSearch: 0
            });
            $('#amenityList').select2({
                dropdownParent: $('#roomModal'),
                width: '100%',
                placeholder: 'Chọn tiện nghi',
                allowClear: true
            });

            // ===== CREATE =====
            $("#btnAddNew").on("click", function () {

                $("#Id").val(0);
                $("#RoomNumber").val("");
                $("#FloorId").val(null).trigger('change');
                $("#RoomTypeId").val(null).trigger('change');
                $("#RoomImages").val("");
                $("#imagePreview").empty();

               $("#Status").val(1).prop("disabled", true);

                loadRoomTypeDropdown();
                loadFloorDropdown();
                loadAmenities();

                $('#IsActive').prop('checked', true); // mặc định hoạt động

                $('.updateFields').hide(); // hiện field update
                $('.updateFields :input').prop('disabled', true); // disable field update

                $("#modalTitle").text("Thêm loại phòng");

                var modal = new bootstrap.Modal(document.getElementById('roomModal'));
                modal.show();
            });

            // ===== PREVIEW IMAGES =====
            $("#RoomImages").on("change", function () {
                const preview = $("#imagePreview");
                preview.empty();
                const files = this.files;
                if (files.length > 5) {
                    Swal.fire("Cảnh báo", "Bạn chỉ được chọn tối đa 5 ảnh", "warning");
                    this.value = "";
                    return;
                }
                for (let i = 0; i < files.length; i++) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        preview.append(`<img src="${e.target.result}" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;">`);
                    }
                    reader.readAsDataURL(files[i]);
                }
            });

            // ===== SAVE =====
            $("#btnSave").on("click", function () {

                var id = Number($("#Id").val());
                var amenityIds = $("#amenityList").val() || [];
                
                var formData = new FormData();
                formData.append("Id", id);
                formData.append("RoomNumber", $("#RoomNumber").val());
                formData.append("FloorId", $("#FloorId").val());
                formData.append("RoomTypeId", $("#RoomTypeId").val());
                formData.append("Status", $("#Status").val());
                formData.append("IsActive", $('#IsActive').prop('checked'));
                
                amenityIds.forEach(val => formData.append("AmenityIds", val));
                
                const files = $("#RoomImages")[0].files;
                for (let i = 0; i < files.length; i++) {
                    formData.append("Images", files[i]);
                }

                var isUpdate = id > 0;

                $.ajax({
                    url: isUpdate
                        ? "/Admin/Rooms/Update"
                        : "/Admin/Rooms/Create",

                    type: "POST", // Use POST for both when using FormData
                    data: formData,
                    processData: false,
                    contentType: false,

                    success: function (res) {
                        if (res.status === 200) {
                            bootstrap.Modal.getInstance(document.getElementById('roomModal')).hide();
                            Swal.fire({
                                icon: "success",
                                title: "Thành công!",
                                text: isUpdate ? "Cập nhật thành công" : "Thêm thành công"
                            }).then(() => location.reload());
                        }
                        else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Lỗi", "Có lỗi xảy ra", "error");
                    }
                });
            });

        });

               // ===== EDIT =====
        function openEdit(id) {

            $.get("/Admin/Rooms/GetById/" + id, function (res) {

                $("#Id").val(res.id);
                $("#RoomNumber").val(res.roomNumber);

                loadRoomTypeDropdown(res.roomTypeId);
                loadFloorDropdown(res.floorId);
                loadAmenities(res.amenityIds);

                $("#Status").val(res.status).trigger('change');
                $('#IsActive').prop('checked', res.isActive);
                
                $("#RoomImages").val("");
                const preview = $("#imagePreview");
                preview.empty();
                if (res.images && res.images.length > 0) {
                    res.images.forEach(img => {
                        preview.append(`<img src="${img}" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;">`);
                    });
                }

                $('.updateFields').show();
                $('.updateFields :input').prop('disabled', false);

                $("#modalTitle").text("Cập nhật phòng");

                var modal = new bootstrap.Modal(document.getElementById('roomModal'));
                modal.show();
            });
        }

        // ===== DELETE =====
            $(document).on("click", ".btn-delete", function () {
            var id = $(this).data("id");

            Swal.fire({
                title: "Bạn chắc chắn?",
                text: "Không thể hoàn tác!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Xóa",
                cancelButtonText: "Hủy"
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: "/Admin/Rooms/Delete/",
                        type: "DELETE",
                        data : {id : id},
                        success: function () {

                            Swal.fire("Đã xóa!", "", "success")
                                .then(() => location.reload());
                        }
                    });

                }
            });
        });

        // ===== LOAD ROOM TYPE =====
        function loadRoomTypeDropdown(selectedValue = null) {

            const select = $("#RoomTypeId");
            select.empty();
            select.append('<option value="">Chọn loại phòng</option>');

            $.get("/Admin/RoomTypes/GetRoomTypes", function (res) {

                if (res.status === 200 && res.resources) {

                    res.resources.forEach(o => {
                        select.append(new Option(o.text, o.value));
                    });

                    if (selectedValue !== null) {
                        select.val(selectedValue).trigger('change.select2');
                    }
                }
            });
        }
        // ===== LOAD FLOOR =====
        function loadFloorDropdown(selectedValue = null) {

            const select = $("#FloorId");
            select.empty();
            select.append('<option value="">Chọn tầng</option>');

            $.get("/Admin/Floors/GetFloors", function (res) {

                if (res.status === 200 && res.resources) {

                    res.resources.forEach(o => {
                        select.append(new Option(o.text, o.value));
                    });

                    if (selectedValue !== null) {
                        select.val(selectedValue).trigger('change.select2');
                    }
                }
            });
        }

        // ======== LOAD AMENITY ==========
        function loadAmenities(selectedAmenities = []) {

            const select = $("#amenityList");
            select.empty();

            $.get("/Admin/Amenities/GetAmenities", function (res) {

                if (res.status === 200 && res.resources) {

                    res.resources.forEach(a => {
                        select.append(new Option(a.text, a.value));
                    });

                    if (selectedAmenities.length > 0) {
                        select.val(selectedAmenities).trigger('change');
                    }
                }
            });
        }
    </script>
}