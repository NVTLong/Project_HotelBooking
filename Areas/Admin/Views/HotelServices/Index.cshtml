@using Project_HotelBooking.Enums
@using Project_HotelBooking.Enums.Helper
@model IEnumerable<Project_HotelBooking.Application.DTOs.Service.HotelServiceDto>

@{
    ViewData["Title"] = "Quản lý Dịch vụ";
}

<div class="admin-page-header">
    <h2 class="admin-page-title">Quản lý Dịch vụ</h2>
    <button type="button" class="btn btn-primary" id="btnAddNew">
        <i class="bi bi-plus-lg me-2"></i> Thêm mới
    </button>
</div>

<div class="card card-premium shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tên dịch vụ</th>
                        <th class="text-center">Giá</th>
                        <th class="text-center">Đơn vị</th>
                        <th class="text-center">Loại dịch vụ</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Name</td>
                            <td class="text-center text-primary fw-bold">@item.Price.ToString("N0") VNĐ</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark rounded-pill px-3">@item.Unit</span>
                            </td>
                            <td class="text-center">
                                @if (item.IsOneTime)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 rounded-pill">Một lần</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 rounded-pill">Nhiều lần</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <i class="bi bi-pencil-square text-warning me-3 action-icon" onclick="openEdit(@item.Id)" title="Sửa"></i>
                                <i class="bi bi-trash text-danger action-icon btn-delete" data-id="@item.Id" title="Xóa"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm dịch vụ mới</h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>
            <div class="modal-body">
                <input type="hidden" id="Id" name="Id" />
                <div class="mb-3">
                    <label>Tên dịch vụ</label>
                    <input type="text" id="Name" name="Name" class="form-control" placeholder="Ví dụ: Giặt là cao cấp" />
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label>Giá dịch vụ (VNĐ)</label>
                        <input type="number" id="Price" name="Price" class="form-control" placeholder="50,000" />
                    </div>
                    <div class="col-md-6">
                        <label>Đơn vị tính</label>
                        <input type="text" id="Unit" name="Unit" class="form-control" placeholder="Ví dụ: lần, bộ, giờ" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Dịch vụ thực hiện một lần?</label>
                    <div class="pt-1">
                        <label class="switch">
                            <input type="checkbox" id="IsOnetime" name="IsOnetime">
                            <span class="slider"></span>
                        </label>
                        <span class="ms-2 text-muted sm-text">(Bật nếu khách chỉ cần thanh toán 1 lần duy nhất)</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnSave" class="btn btn-primary">Lưu thông tin</button>
            </div>
        </div>
    </div>
</div>

<style>
    .sm-text { font-size: 0.85rem; vertical-align: middle; }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#btnAddNew").on("click", function () {
                $("#Id").val(0);
                $("#Name").val("");
                $("#Price").val("");
                $("#Unit").val("");
                $('#IsOnetime').prop('checked', false);
                $("#modalTitle").text("Thêm dịch vụ mới");
                new bootstrap.Modal(document.getElementById('serviceModal')).show();
            });

            $("#btnSave").on("click", function () {
                var id = Number($("#Id").val());
                var payload = {
                    Id: id,
                    Name: $("#Name").val(),
                    Price: $("#Price").val(),
                    Unit: $("#Unit").val(),
                    IsOnetime: $('#IsOnetime').prop('checked')
                };
                var isUpdate = id > 0;

                $.ajax({
                    url: isUpdate ? "/Admin/HotelServices/Update" : "/Admin/HotelServices/Create",
                    type: isUpdate ? "PUT" : "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.status === 200) {
                            Swal.fire("Thành công!", isUpdate ? "Cập nhật thành công" : "Thêm thành công", "success")
                                .then(() => location.reload());
                        } else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Lỗi", "Có lỗi xảy ra", "error");
                    }
                });
            });

            $(document).on("click", ".btn-delete", function () {
                var id = $(this).data("id");
                Swal.fire({
                    title: "Xác nhận xóa?",
                    text: "Khách hàng sẽ không thể đặt dịch vụ này nữa!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#ef4444",
                    confirmButtonText: "Xóa ngay",
                    cancelButtonText: "Hủy"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "/Admin/HotelServices/Delete/",
                            type: "DELETE",
                            data: { id: id },
                            success: function () {
                                Swal.fire("Đã xóa!", "Dịch vụ đã được loại bỏ.", "success").then(() => location.reload());
                            }
                        });
                    }
                });
            });
        });

        function openEdit(id) {
            $.get("/Admin/HotelServices/GetById/" + id, function (res) {
                $("#Id").val(res.id);
                $("#Name").val(res.name);
                $("#Price").val(res.price);
                $("#Unit").val(res.unit);
                $('#IsOnetime').prop('checked', res.isOnetime);
                $("#modalTitle").text("Cập nhật dịch vụ");
                new bootstrap.Modal(document.getElementById('serviceModal')).show();
            });
        }
    </script>
}
