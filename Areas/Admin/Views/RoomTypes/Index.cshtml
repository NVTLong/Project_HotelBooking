@model IEnumerable<Project_HotelBooking.Application.DTOs.RoomType.RoomTypeDto>
@using Project_HotelBooking.Enums.Helper

@{
    ViewData["Title"] = "Quản lý Loại phòng";
}

<div class="admin-page-header">
    <h2 class="admin-page-title">Quản lý Loại phòng</h2>
    <button type="button" class="btn btn-primary" id="btnAddNew">
        <i class="bi bi-plus-lg me-2"></i> Thêm mới
    </button>
</div>

<div class="card card-premium shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Loại phòng</th>
                        <th class="text-center">Giá cơ bản</th>
                        <th class="text-center">Sức chứa</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Name</td>
                            <td class="text-center text-primary fw-bold">@item.BasePrice.ToString("N0") VNĐ</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark rounded-pill px-3">@item.Capacity người</span>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="status-badge badge-active">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-inactive">Dừng hoạt động</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <i class="bi bi-pencil-square text-warning me-3 action-icon" onclick="openEdit(@item.Id)" title="Sửa"></i>
                                <i class="bi bi-trash text-danger action-icon btn-delete" data-id="@item.Id" title="Xóa"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="roomTypeModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm loại phòng</h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>
            <div class="modal-body">
                <input type="hidden" id="Id" name="Id" />
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label>Tên loại phòng</label>
                        <input type="text" id="Name" name="Name" class="form-control" placeholder="Ví dụ: Deluxe Sea View" />
                    </div>
                    <div class="col-md-6">
                        <label>Giá cơ bản (VNĐ)</label>
                        <input type="number" id="BasePrice" name="BasePrice" class="form-control" min="0" placeholder="1,000,000" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label>Sức chứa tối đa</label>
                        <input type="number" id="Capacity" name="Capacity" class="form-control" min="1" placeholder="Ví dụ: 2" />
                    </div>
                    <div class="col-md-6 pt-2" id="updateFields" style="display:none">
                        <label>Hoạt động</label>
                        <div class="d-flex align-items-center" style="height: 46px;">
                            <label class="switch">
                                <input type="checkbox" id="IsActive" name="IsActive" checked>
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label>Mô tả chi tiết</label>
                    <textarea id="Description" name="Description" class="form-control" rows="4" placeholder="Mô tả về tiện ích, không gian..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnSave" class="btn btn-primary">Lưu thông tin</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            $("#btnAddNew").on("click", function () {
                $("#Id").val(0);
                $("#Name").val("");
                $("#BasePrice").val("");
                $("#Capacity").val("");
                $("#Description").val("");
                $('#IsActive').prop('checked', true);
                $('#updateFields').hide();
                $("#modalTitle").text("Thêm loại phòng");
                new bootstrap.Modal(document.getElementById('roomTypeModal')).show();
            });

            $("#btnSave").on("click", function () {
                var id = Number($("#Id").val());
                var payload = {
                    Id: id,
                    Name: $("#Name").val(),
                    BasePrice: $("#BasePrice").val(),
                    Capacity: $("#Capacity").val(),
                    Description: $("#Description").val(),
                    IsActive: $('#IsActive').prop('checked')
                };
                var isUpdate = id > 0;

                $.ajax({
                    url: isUpdate ? "/Admin/RoomTypes/Update" : "/Admin/RoomTypes/Create",
                    type: isUpdate ? "PUT" : "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.status === 200) {
                            Swal.fire("Thành công!", isUpdate ? "Cập nhật thành công" : "Thêm thành công", "success")
                                .then(() => location.reload());
                        } else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Lỗi", "Có lỗi xảy ra", "error");
                    }
                });
            });

            $(document).on("click", ".btn-delete", function () {
                var id = $(this).data("id");
                Swal.fire({
                    title: "Xác nhận xóa?",
                    text: "Tất cả phòng thuộc loại này sẽ bị ảnh hưởng!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#ef4444",
                    confirmButtonText: "Xóa ngay",
                    cancelButtonText: "Hủy"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "/Admin/RoomTypes/Delete/",
                            type: "DELETE",
                            data: { id: id },
                            success: function () {
                                Swal.fire("Đã xóa!", "Loại phòng đã được loại bỏ.", "success").then(() => location.reload());
                            }
                        });
                    }
                });
            });
        });

        function openEdit(id) {
            $.get("/Admin/RoomTypes/GetById/" + id, function (res) {
                $("#Id").val(res.id);
                $("#Name").val(res.name);
                $("#BasePrice").val(res.basePrice);
                $("#Capacity").val(res.capacity);
                $("#Description").val(res.description);
                $('#IsActive').prop('checked', res.isActive);
                $('#updateFields').show();
                $("#modalTitle").text("Cập nhật loại phòng");
                new bootstrap.Modal(document.getElementById('roomTypeModal')).show();
            });
        }
    </script>
}