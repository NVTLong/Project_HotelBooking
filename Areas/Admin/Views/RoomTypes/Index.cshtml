@model IEnumerable<Project_HotelBooking.Application.DTOs.RoomType.RoomTypeDto>

@{
    ViewData["Title"] = "Index";
}

<button type="button" class="btn btn-primary me-2" id="btnAddNew">
    <span class="svg-icon svg-icon svg-icon-1 svg_plus p-0"></span> Thêm mới
</button>
<div class="table-scroll mt-2">
    <table class="table table-bordered">
        <thead>
            <tr class="text-center">
                <th>Loại phòng</th>
                <th>Giá cơ bản</th>
                <th>Số người tối đa</th>
                <th>Tình trạng</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">@item.Name</td>
                    <td class="text-center">@item.BasePrice.ToString("N0")</td>
                    <td class="text-center">@item.Capacity</td>
                    <td class="text-center">
                        @if (item.IsActive)
                        {
                            <span class="status-active">Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="status-inactive">Dừng hoạt động</span>
                        }
                    </td>


                    <td class="text-center">

                        <i class="bi bi-pencil-square fs-3 text-warning me-3 action-icon btn-edit"
                           onclick="openEdit(@item.Id)"
                           title="Edit"></i>

                        @* <i class="bi bi-eye-fill fs-3 text-info me-3 action-icon btn-detail"
                           data-id="@item.Id"
                           title="Details"></i> *@

                        <i class="bi bi-trash fs-3 text-danger action-icon btn-delete"
                           data-id="@item.Id"
                           title="Delete"></i>

                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="roomTypeModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>

            <div class="modal-body">

                <!-- Hidden Id để phân biệt Create / Edit -->
                <input type="hidden" id="Id" name="Id" />
                <div class="row mb-3">

                    <div class="col-6">
                        <label>Loại phòng</label>
                        <input type="text" id="Name" name="Name" class="form-control" />
                    </div>

                    <div class="col-6">
                        <label>Giá cơ bản</label>
                        <input type="number" id="BasePrice" name="BasePrice" class="form-control" min="0" />
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-6">
                        <label>Số lượng người tối đa</label>
                        <input type="text" id="Capacity" name="Capacity" class="form-control" min="0" />
                    </div>

                    <!-- Field Ẩn khi Create -->
                    <div class="col-6" id="updateFields" style="display:none">
                        <label>Hoạt động</label>

                        <label class="switch">
                            <input type="checkbox"
                                   id="IsActive"
                                   name="IsActive"
                                   value="true">
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>

                <hr />

                <div class="row col-12">
                    <label>Mô tả</label>
                    <textarea id="Description" name="Description" class="form-control" rows="4"></textarea>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" id="btnSave" class="btn btn-primary">Lưu</button>
            </div>

        </div>
    </div>
</div>

<!-- JS -->
@section Scripts {
    <script>
            $(document).ready(function () {

            // ===== CREATE =====
            $("#btnAddNew").on("click", function () {

                $("#Id").val(0);
                $("#Name").val("");
                $("#BasePrice").val("");
                $("#Capacity").val("");
                $("#Description").val("");

                $('#IsActive').prop('checked', true); // mặc định hoạt động

                $('#updateFields').hide(); // hiện field update
                $('#updateFields :input').prop('disabled', true); // disable field update

                $("#modalTitle").text("Thêm loại phòng");

                var modal = new bootstrap.Modal(document.getElementById('roomTypeModal'));
                modal.show();
            });

            // ===== SAVE =====
            $("#btnSave").on("click", function () {

                var id = Number($("#Id").val());

                var payload = {
                    Id: id,
                    Name: $("#Name").val(),
                    BasePrice: $("#BasePrice").val(),
                    Capacity: $("#Capacity").val(),
                    Description: $("#Description").val(),
                    IsActive: $('#IsActive').prop('checked')
                };

                var isUpdate = id > 0;

                $.ajax({
                    url: isUpdate
                        ? "/Admin/RoomTypes/Update"
                        : "/Admin/RoomTypes/Create",

                    type: isUpdate ? "PUT" : "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),

                    success: function (res) {

                        if (res.status === 200) {

                            bootstrap.Modal.getInstance(document.getElementById('roomTypeModal')).hide();

                            Swal.fire({
                                icon: "success",
                                title: "Thành công!",
                                text: isUpdate ? "Cập nhật thành công" : "Thêm thành công"
                            }).then(() => location.reload());
                        }
                        else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Lỗi", "Có lỗi xảy ra", "error");
                    }
                });
            });

        });

        // ===== EDIT =====
            function openEdit(id) {

            $.get("/Admin/RoomTypes/GetById/" + id, function (res) {

                $("#Id").val(res.id);
                $("#Name").val(res.name);
                $("#BasePrice").val(res.basePrice);
                $("#Capacity").val(res.capacity);
                $("#Description").val(res.description);
                $('#IsActive').prop('checked', res.isActive);

                $('#updateFields').show(); // hiện field update
                $('#updateFields :input').prop('disabled', false); // enable lại

                $("#modalTitle").text("Cập nhật loại phòng");

                var modal = new bootstrap.Modal(document.getElementById('roomTypeModal'));
                modal.show();
            });
            }
        // ===== DELETE =====
            $(document).on("click", ".btn-delete", function () {
            var id = $(this).data("id");

            Swal.fire({
                title: "Bạn chắc chắn?",
                text: "Không thể hoàn tác!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Xóa",
                cancelButtonText: "Hủy"
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: "/Admin/RoomTypes/Delete/",
                        type: "DELETE",
                        data : {id : id},
                        success: function () {

                            Swal.fire("Đã xóa!", "", "success")
                                .then(() => location.reload());
                        }
                    });

                }
            });
        });

    </script>
}
<style>
    .action-icon {
        font-size: 24px;
        padding: 6px;
        border-radius: 6px;
        transition: 0.2s;
    }

        .action-icon:hover {
            filter: brightness(70%);
        }

    /* IsActive*/
    .switch {
        position: relative;
        display: inline-block;
        width: 55px;
        height: 28px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #ccc;
        border-radius: 30px;
        transition: 0.3s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            border-radius: 50%;
            transition: 0.3s;
        }

    input:checked + .slider {
        background-color: #7c3aed;
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

        /* CSS IsActive */
    .status-active {
        background-color: #e8f7ee;
        color: #1e7e34;
        border: 1px solid #28a745;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .status-inactive {
        background-color: #fdeaea;
        color: #c82333;
        border: 1px solid #dc3545;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
</style>