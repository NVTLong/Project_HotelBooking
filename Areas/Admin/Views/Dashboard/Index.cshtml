@model Project_HotelBooking.Areas.Admin.ViewModels.DashboardVM
@using Project_HotelBooking.Enums.Helper

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-card {
        border: none;
        border-radius: 20px;
        padding: 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .card-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .icon-blue { background: #eff6ff; color: #3b82f6; }
    .icon-green { background: #f0fdf4; color: #22c55e; }
    .icon-purple { background: #faf5ff; color: #a855f7; }
    .icon-orange { background: #fff7ed; color: #f97316; }

    .stat-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .stat-value {
        font-size: 1.875rem;
        font-weight: 700;
        color: #1e293b;
        margin-top: 0.25rem;
    }

    .table-premium {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .table-premium thead {
        background: #f8fafc;
    }

    .table-premium th {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: #64748b;
        padding: 1.25rem 1.5rem;
        border: none;
    }

    .table-premium td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
        color: #334155;
    }

    .status-badge {
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-paid { background: #dcfce7; color: #166534; }
    .badge-pending { background: #fef9c3; color: #854d0e; }

    /* ALERT STYLES */
    .alert-card {
        border-radius: 16px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        border: 1px solid rgba(0,0,0,0.05);
    }
    .alert-warning { background: #fffbeb; color: #92400e; border-color: #fef3c7; }
    .alert-danger { background: #fef2f2; color: #991b1b; border-color: #fee2e2; }
    .alert-info { background: #eff6ff; color: #1e40af; border-color: #dbeafe; }
</style>

<div class="container-fluid py-4">
    <!-- Dashboard Header and Alerts -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <h1 class="h3 fw-bold text-gray-800 mb-0" style="font-family: 'Playfair Display', serif;">Quản lý chung</h1>
            <p class="text-muted">Chào mừng trở lại, đây là tình hình khách sạn hôm nay.</p>
        </div>
        <div class="col-lg-4">
            @if (Model.IsLowAvailability)
            {
                <div class="alert-card alert-danger shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    <div>
                        <div class="fw-bold">Phòng sắp hết!</div>
                        <div class="small opacity-75">Chỉ còn dưới 15% phòng trống.</div>
                    </div>
                </div>
            }
            @if (Model.TodayCheckInsCount > 0)
            {
                <div class="alert-card alert-info shadow-sm">
                    <i class="bi bi-calendar-event-fill fs-4"></i>
                    <div>
                        <div class="fw-bold">@Model.TodayCheckInsCount lượt Check-in hôm nay</div>
                        <div class="small opacity-75">Hãy chuẩn bị đón khách.</div>
                    </div>
                </div>
            }
            @if (Model.UnpaidBookingsCount > 0)
            {
                <div class="alert-card alert-warning shadow-sm">
                    <i class="bi bi-wallet2 fs-4"></i>
                    <div>
                        <div class="fw-bold">@Model.UnpaidBookingsCount đơn chưa thanh toán</div>
                        <div class="small opacity-75">Cần kiểm tra lại trạng thái.</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-4 mb-4">
        <!-- Revenue Card -->
        <div class="col-md-3">
            <div class="dashboard-card border-start border-4 border-success">
                <div class="card-icon icon-green">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div class="stat-label">Tổng doanh thu</div>
                <div class="stat-value">@Model.TotalRevenue.ToString("N0")đ</div>
            </div>
        </div>

        <!-- Rooms In Use Card -->
        <div class="col-md-3">
            <div class="dashboard-card border-start border-4 border-primary">
                <div class="card-icon icon-blue">
                    <i class="bi bi-door-open-fill"></i>
                </div>
                <div class="stat-label">Phòng đang dùng</div>
                <div class="stat-value">@Model.RoomsInUse / @Model.TotalRooms</div>
            </div>
        </div>

        <!-- Bookings Card -->
        <div class="col-md-3">
            <div class="dashboard-card border-start border-4 border-purple">
                <div class="card-icon icon-purple">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="stat-label">Tổng lượt đặt</div>
                <div class="stat-value">@Model.TotalBookings</div>
            </div>
        </div>

        <!-- Customers Card -->
        <div class="col-md-3">
            <div class="dashboard-card border-start border-4 border-orange">
                <div class="card-icon icon-orange">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-label">Khách hàng</div>
                <div class="stat-value">@Model.TotalCustomers</div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="dashboard-card">
                <h5 class="fw-bold mb-4" style="font-family: 'Playfair Display', serif;">Xu hướng doanh thu (7 ngày qua)</h5>
                <canvas id="revenueChart" height="100"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="dashboard-card">
                <h5 class="fw-bold mb-4" style="font-family: 'Playfair Display', serif;">Lượt đặt mới</h5>
                <canvas id="bookingsChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Bookings Table -->
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold m-0" style="font-family: 'Playfair Display', serif;">Đặt phòng gần đây</h5>
                <a href="/Admin/Bookings" class="btn btn-sm btn-link text-decoration-none">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="table-premium shadow-sm">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đến</th>
                            <th>Ngày đi</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBookings != null)
                        {
                            foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td class="fw-bold">#@booking.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle p-2 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-person text-muted"></i>
                                            </div>
                                            @booking.Customer?.FullName
                                        </div>
                                    </td>
                                    <td>@booking.CheckInDate.ToString("dd/MM/yyyy")</td>
                                    <td>@booking.CheckOutDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="status-badge @(booking.Status == Project_HotelBooking.Enums.BookingStatus.Confirmed ? "badge-paid" : "badge-pending")">
                                            @EnumHelper.GetDisplayName(booking.Status)
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Room Status Summary -->
        <div class="col-lg-4">
            <h5 class="fw-bold mb-3" style="font-family: 'Playfair Display', serif;">Tình trạng phòng</h5>
            <div class="dashboard-card shadow-sm p-4">
                <div class="list-group list-group-flush">
                    @if (Model.RoomStatusStats != null)
                    {
                        foreach (var stat in Model.RoomStatusStats)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 border-light py-3">
                                <div class="d-flex align-items-center">
                                    <span class="rounded-circle me-3" style="width: 10px; height: 10px; background: @(stat.Key == Project_HotelBooking.Enums.RoomStatus.Available ? "#22c55e" : (stat.Key == Project_HotelBooking.Enums.RoomStatus.Occupied ? "#3b82f6" : "#f59e0b"))"></span>
                                    <span class="fw-medium">@EnumHelper.GetDisplayName(stat.Key)</span>
                                </div>
                                <span class="badge bg-light text-dark rounded-pill fw-bold">@stat.Value</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Revenue Chart
        const revCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ChartLabels)),
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: @Html.Raw(Json.Serialize(Model.RevenueData)),
                    borderColor: '#22c55e',
                    backgroundColor: 'rgba(34, 197, 94, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { callback: value => value.toLocaleString() + 'đ' } }
                }
            }
        });

        // Bookings Chart
        const listCtx = document.getElementById('bookingsChart').getContext('2d');
        new Chart(listCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ChartLabels)),
                datasets: [{
                    label: 'Số lượt đặt',
                    data: @Html.Raw(Json.Serialize(Model.BookingData)),
                    backgroundColor: '#a855f7',
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, stepSize: 1 } }
            }
        });
    </script>
}
