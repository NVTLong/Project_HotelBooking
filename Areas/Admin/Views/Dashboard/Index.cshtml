@model Project_HotelBooking.Areas.Admin.ViewModels.DashboardVM
@using Project_HotelBooking.Enums.Helper

@{
    ViewData["Title"] = "Dashboard Quản trị";
}

<div class="admin-page-header">
    <h2 class="admin-page-title">Tổng quan Hệ thống</h2>
    <div class="text-muted small">Cập nhật lần cuối: @DateTime.Now.ToString("HH:mm, dd/MM/yyyy")</div>
</div>

<!-- Thống kê nhanh -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card card-premium h-100 border-0 shadow-sm p-4 text-center">
            <div class="card-icon mx-auto mb-3 bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-calendar-check fs-3"></i>
            </div>
            <div class="text-muted small text-uppercase fw-bold mb-1">Tổng Booking</div>
            <div class="h2 fw-bold mb-0">@Model.TotalBookings</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-premium h-100 border-0 shadow-sm p-4 text-center">
            <div class="card-icon mx-auto mb-3 bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-currency-dollar fs-3"></i>
            </div>
            <div class="text-muted small text-uppercase fw-bold mb-1">Doanh thu (Tháng)</div>
            <div class="h2 fw-bold mb-0">@Model.TotalRevenue.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-premium h-100 border-0 shadow-sm p-4 text-center">
            <div class="card-icon mx-auto mb-3 bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-door-open fs-3"></i>
            </div>
            <div class="text-muted small text-uppercase fw-bold mb-1">Phòng trống</div>
            <div class="h2 fw-bold mb-0">@Model.RoomsAvailable</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-premium h-100 border-0 shadow-sm p-4 text-center">
            <div class="card-icon mx-auto mb-3 bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-people fs-3"></i>
            </div>
            <div class="text-muted small text-uppercase fw-bold mb-1">Dịch vụ đang dùng</div>
            <div class="h2 fw-bold mb-0">@Model.ActiveServicesCount</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Chart: Monthly Revenue -->
    <div class="col-lg-8">
        <div class="card card-premium border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Biểu đồ Doanh thu (6 tháng gần đây)</h5>
                <i class="bi bi-graph-up text-primary fs-4"></i>
            </div>
            <div class="card-body p-4">
                <canvas id="revenueChart" height="280"></canvas>
            </div>
        </div>
    </div>

    <!-- Stats: Bookings by Month Table -->
    <div class="col-lg-4">
        <div class="card card-premium border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Booking theo tháng</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Tháng</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end pe-4">Phần trăm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.BookingsByMonth)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">Tháng @entry.Key</td>
                                    <td class="text-center">@entry.Value</td>
                                    <td class="text-end pe-4">
                                        @{
                                            var percent = Model.TotalBookings > 0 ? (entry.Value * 100 / Model.TotalBookings) : 0;
                                        }
                                        <div class="d-flex align-items-center justify-content-end">
                                            <div class="progress w-50 me-2" style="height: 6px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @percent%"></div>
                                            </div>
                                            <span class="small text-muted">@percent%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Bookings -->
    <div class="col-12">
        <div class="card card-premium border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Bookings Gần đây</h5>
                <a href="/Admin/Bookings" class="btn btn-sm btn-outline-primary rounded-pill">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Mã Booking</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th class="text-center">Số tiền</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end pe-4">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr id="booking-@booking.Id">
                                    <td class="ps-4"><span class="badge bg-light text-dark rounded-pill px-3">#@booking.Id</span></td>
                                    <td class="fw-bold">@(booking.Customer?.FullName ?? "N/A")</td>
                                    <td class="text-muted small">@booking.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center fw-bold text-primary">@booking.TotalAmount.ToString("N0")</td>
                                    <td class="text-center">
                                        @if (booking.Status == Project_HotelBooking.Enums.BookingStatus.Pending)
                                        {
                                            <span class="status-badge badge-active">Thành công</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-warning">Chờ xử lý</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="/Admin/BookingDetails/Index/@booking.Id" class="btn btn-sm btn-primary rounded-pill px-3">Chi tiết</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Biểu đồ doanh thu
            const ctx = document.getElementById('revenueChart').getContext('2d');
            
            // Dữ liệu mẫu (Cần backend pass thêm list Doanh thu theo tháng)
            const labels = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6'];
            const data = [12000000, 19000000, 15000000, 25000000, 22000000, 30000000];

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: data,
                        borderColor: '#7c3aed',
                        backgroundColor: 'rgba(124, 58, 237, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#7c3aed',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { size: 12 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 12 } }
                        }
                    }
                }
            });
        });
    </script>
}
