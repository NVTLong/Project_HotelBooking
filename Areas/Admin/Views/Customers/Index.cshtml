@using Project_HotelBooking.Enums
@using Project_HotelBooking.Enums.Helper
@model IEnumerable<Project_HotelBooking.Application.DTOs.Customer.CustomerDto>

@{
    ViewData["Title"] = "Index";
}
<div class="admin-page-header">
    <h2 class="admin-page-title">Quản lý Khách hàng</h2>
    <button type="button" class="btn btn-primary" id="btnAddNew">
        <i class="bi bi-plus-lg me-2"></i> Thêm mới
    </button>
</div>
<div class="card card-premium shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Họ và tên</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Địa chỉ</th>
                        <th>CCCD/CMT</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.FullName</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Email</td>
                            <td>@item.Address</td>
                            <td>@item.IdentityNumber</td>
                            <td class="text-end pe-4">
                                <i class="bi bi-pencil-square text-warning me-3 action-icon btn-edit" onclick="openEdit(@item.Id)" title="Sửa"></i>
                                <i class="bi bi-trash text-danger action-icon btn-delete" data-id="@item.Id" title="Xóa"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="customerModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <i class="bi bi-x-lg" data-bs-dismiss="modal" style="cursor: pointer;"></i>
            </div>

            <div class="modal-body">

                <!-- Hidden Id để phân biệt Create / Edit -->
                <input type="hidden" id="Id" name="Id" />

                <div class="row mb-3">

                    <!-- Tên phòng -->
                    <div class="col-6">
                        <label>Họ và tên</label>
                        <input type="text" id="FullName" name="FullName" class="form-control" />
                    </div>

                    <!-- Tầng -->
                    <div class="col-6">
                        <label>Số điện thoại</label>
                        <input type="text" id="PhoneNumber" name="PhoneNumber" class="form-control">
                    </div>

                </div>

                <div class="row mb-3">

                    <!-- Tên phòng -->
                    <div class="col-6">
                        <label>Email</label>
                        <input type="text" id="Email" name="Email" class="form-control" />
                    </div>

                    <!-- Tầng -->
                    <div class="col-6">
                        <label>Địa chỉ</label>
                        <input type="text" id="Address" name="Address" class="form-control">
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-6">
                        <label>CCCD/CMT</label>
                        <input type="text" id="IdentityNumber" name="IdentityNumber" class="form-control">
                    </div>

                   
                </div>               

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSave" class="btn btn-primary">Lưu</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JS -->
@section Scripts {
    <script>
            $(document).ready(function () {
            // ===== CREATE =====
            $("#btnAddNew").on("click", function () {

                $("#Id").val(0);
                $("#FullName").val("");
                $("#PhoneNumber").val("");
                $("#Email").val("");
                $("#Address").val("");
                $("#IdentityNumber").val("");
               

                $("#modalTitle").text("Thêm mới khách hàng");

                var modal = new bootstrap.Modal(document.getElementById('customerModal'));
                modal.show();
            });

            // ===== SAVE =====
            $("#btnSave").on("click", function () {

                var id = Number($("#Id").val());
                var amenityIds = $("#amenityList").val() || [];
                amenityIds = amenityIds.map(Number);

                var payload = {
                    Id: id,
                    FullName: $("#FullName").val(),
                    PhoneNumber: $("#PhoneNumber").val(),
                    Email: $("#Email").val(),
                    Address: $("#Address").val(),
                    IdentityNumber: $("#IdentityNumber").val(),

                };

                var isUpdate = id > 0;

                $.ajax({
                    url: isUpdate
                        ? "/Admin/Customers/Update"
                        : "/Admin/Customers/Create",

                    type: isUpdate ? "PUT" : "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),

                    success: function (res) {

                        if (res.status === 200) {

                            bootstrap.Modal.getInstance(document.getElementById('customerModal')).hide();

                            Swal.fire({
                                icon: "success",
                                title: "Thành công!",
                                text: isUpdate ? "Cập nhật thành công" : "Thêm thành công"
                            }).then(() => location.reload());
                        }
                        else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Lỗi", "Có lỗi xảy ra", "error");
                    }
                });
            });

        });

               // ===== EDIT =====
        function openEdit(id) {

            $.get("/Admin/Customers/GetById/" + id, function (res) {

                $("#Id").val(res.id);
                $("#FullName").val(res.fullName);
                $("#PhoneNumber").val(res.phoneNumber);
                $("#Email").val(res.email);
                $("#Address").val(res.address);
                $("#IdentityNumber").val(res.identityNumber);

                $("#modalTitle").text("Cập nhật thông tin khách hàng");

                var modal = new bootstrap.Modal(document.getElementById('customerModal'));
                modal.show();
            });
        }

        // ===== DELETE =====
            $(document).on("click", ".btn-delete", function () {
            var id = $(this).data("id");

            Swal.fire({
                title: "Bạn chắc chắn?",
                text: "Không thể hoàn tác!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Xóa",
                cancelButtonText: "Hủy"
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: "/Admin/Customers/Delete/",
                        type: "DELETE",
                        data : {id : id},
                        success: function () {

                            Swal.fire("Đã xóa!", "", "success")
                                .then(() => location.reload());
                        }
                    });

                }
            });
        });

    </script>
}