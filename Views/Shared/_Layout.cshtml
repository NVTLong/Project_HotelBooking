<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Luxury Hotel</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- Icons & Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        :root {
            --primary-navy: #0f172a;
            --accent-gold: #fbbf24;
            --soft-white: #f8fafc;
            --text-muted: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--primary-navy);
            background-color: #fff;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, .navbar-brand {
            font-family: 'Playfair Display', serif;
        }

        /* Navbar Styling */
        .navbar {
            padding: 1.5rem 0;
            transition: all 0.4s ease;
            background: transparent !important;
            border-bottom: 1px solid rgba(255,255,255,0.1) !important;
        }

        .navbar.scrolled, .navbar.navbar-solid {
            padding: 1rem 0;
            background: rgba(15, 23, 42, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            border-bottom: 1px solid rgba(255,255,255,0.05) !important;
        }

        .navbar-brand {
            font-size: 1.6rem;
            font-weight: 700;
            color: #fff !important;
            letter-spacing: 1px;
        }

        .nav-link {
            color: rgba(255,255,255,0.8) !important;
            font-weight: 400;
            margin: 0 1rem;
            transition: color 0.3s;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1.5px;
        }

        .nav-link:hover {
            color: var(--accent-gold) !important;
        }

        .icon-btn {
            width: 45px;
            height: 45px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: #fff;
            font-size: 1.3rem;
            transition: all 0.3s ease;
            text-decoration: none;
            background: transparent;
            cursor: pointer;
        }
        
        .icon-btn:hover {
            background: var(--accent-gold);
            border-color: var(--accent-gold);
            color: var(--primary-navy);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(251, 191, 36, 0.4);
        }

        /* Footer */
        footer {
            background: linear-gradient(180deg, #0f172a 0%, #020617 100%);
            color: #ccc;
            padding: 5rem 0 2rem;
            font-size: 0.9rem;
            position: relative;
            overflow: hidden;
        }

        footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.3), transparent);
        }

        footer h5 {
            color: #fff;
            margin-bottom: 1.5rem;
            font-size: 1.25rem;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        footer .footer-link {
            color: #cbd5e1;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-block;
            margin-bottom: 0.75rem;
            position: relative;
        }

        footer .footer-link:hover {
            color: var(--accent-gold);
            transform: translateX(5px);
        }

        footer hr {
            border-color: rgba(255, 255, 255, 0.05);
            margin: 3rem 0 2rem;
        }

        .newsletter-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 3rem;
            margin-bottom: 4rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }

        .newsletter-input {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            padding: 0.8rem 1.5rem;
            border-radius: 50px;
            transition: all 0.3s;
        }

        .newsletter-input:focus {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--accent-gold);
            box-shadow: 0 0 15px rgba(251, 191, 36, 0.2);
            color: #fff;
            outline: none;
        }

        .newsletter-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .newsletter-btn {
            background: var(--accent-gold);
            color: var(--primary-navy);
            border: none;
            padding: 0.8rem 2rem;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .newsletter-btn:hover {
            background: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(251, 191, 36, 0.3);
        }

        .social-link {
            width: 45px;
            height: 45px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-right: 0.75rem;
            color: #fff;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            font-size: 1.2rem;
        }

        .social-link:hover {
            background: var(--accent-gold);
            border-color: var(--accent-gold);
            color: var(--primary-navy);
            transform: translateY(-5px) rotate(360deg);
            box-shadow: 0 10px 20px rgba(251, 191, 36, 0.3);
        }

        .contact-info-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 1.2rem;
            color: #cbd5e1;
        }

        .contact-info-item i {
            color: var(--accent-gold);
            font-size: 1.1rem;
            margin-right: 1rem;
            margin-top: 0.2rem;
        }

        footer .text-muted {
            color: #cbd5e1 !important;
        }

        footer .text-white {
            color: #fff !important;
        }

        /* User Dropdown Profile */
        .user-dropdown .dropdown-toggle::after {
            display: none; /* Hide default arrow */
        }
        .user-dropdown .dropdown-menu {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 0.5rem;
            margin-top: 1.2rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            min-width: 220px;
            border-top: 2px solid var(--accent-gold);
        }
        .user-dropdown .dropdown-item {
            color: rgba(255, 255, 255, 0.8) !important;
            padding: 0.7rem 1.2rem;
            border-radius: 8px;
            transition: all 0.2s;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
        }
        .user-dropdown .dropdown-item:hover {
            background: rgba(251, 191, 36, 0.1);
            color: var(--accent-gold) !important;
            transform: translateX(5px);
        }
        .user-dropdown .dropdown-divider {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin: 0.5rem 0;
        }
        .user-dropdown .dropdown-header {
            color: var(--accent-gold);
            font-weight: 600;
            padding: 0.8rem 1.2rem;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-family: 'Inter', sans-serif;
        }
        .user-dropdown .dropdown-item i {
            font-size: 1.1rem;
            margin-right: 0.8rem;
        }
    </style>
</head>
<body>
    <header>
        @{
            var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && 
                         ViewContext.RouteData.Values["action"]?.ToString() == "Index";
        }
        <nav class="navbar navbar-expand-lg fixed-top @(isHome ? "" : "navbar-solid")">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    LUXURY <span style="color: var(--accent-gold)">HOTEL</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="bi bi-list text-white fs-2"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @await Component.InvokeAsync("RoomTypeMenu")
                        <li class="nav-item">
                            <a class="nav-link" href="#cuisine">Ẩm thực</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#offers">Ưu đãi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#amenities">Tiện nghi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contact">Liên Hệ</a>
                        </li>
                    </ul>
                    <div class="auth-user-info d-flex align-items-center gap-2 flex-nowrap ms-lg-3">
                        @if (Context.Session.GetString("CustomerEmail") != null)
                        {
                            <div class="dropdown user-dropdown">
                                <button class="icon-btn dropdown-toggle p-0 overflow-hidden" type="button" id="userProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Tài khoản">
                                    @{
                                        var avatarUrl = Context.Session.GetString("CustomerAvatar");
                                    }
                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl" style="width: 100%; height: 100%; object-fit: cover;" alt="Avatar" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle"></i>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userProfileDropdown">
                                    <li><h6 class="dropdown-header">Xin chào, @Context.Session.GetString("CustomerName")</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-badge"></i> Thông tin khách hàng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="BookingHistory">
                                            <i class="bi bi-journal-text"></i> Lịch sử đặt phòng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                            <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="icon-btn" asp-controller="Account" asp-action="Login" title="Đăng nhập">
                                <i class="bi bi-person"></i>
                            </a>
                            <a class="icon-btn" asp-controller="Account" asp-action="Register" title="Đăng ký">
                                <i class="bi bi-person-plus"></i>
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer id="contact">
        <div class="container">
            <!-- Newsletter Section -->
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="newsletter-card text-center">
                        <h2 class="Playfair mb-3 text-white">Nhận Ưu Đãi Đặc Biệt</h2>
                        <p class="text-muted mb-4 mx-auto" style="max-width: 600px;">Đăng ký nhận bản tin của chúng tôi để không bỏ lỡ những khuyến mãi hấp dẫn nhất dành riêng cho bạn.</p>
                        <form class="row g-3 justify-content-center mt-2">
                            <div class="col-md-6">
                                <input type="email" class="form-control newsletter-input" placeholder="Nhập địa chỉ email của bạn...">
                            </div>
                            <div class="col-md-auto">
                                <button type="submit" class="btn newsletter-btn px-5">ĐĂNG KÝ NGAY</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="row text-center text-md-start">
                <div class="col-lg-4 col-md-6 mb-5 mb-lg-0">
                    <a class="navbar-brand text-white d-block mb-4" href="#">
                        LUXURY <span style="color: var(--accent-gold)">HOTEL</span>
                    </a>
                    <p class="text-muted pe-md-4 mb-4" style="line-height: 1.8;">Khám phá sự giao thoa hoàn hảo giữa thiết kế hiện đại và sự hiếu khách đẳng cấp thế giới. Mỗi khoảnh khắc tại đây là một trải nghiệm không thể quên, nơi phong cách gặp gỡ sự thoải mái tuyệt đối.</p>
                    <div class="d-flex justify-content-center justify-content-md-start">
                        <a href="#" class="social-link" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-link" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-link" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-link" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                
                <div class="col-lg-2 col-6 mb-5 mb-lg-0">
                    <h5>Liên Kết</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="footer-link">Về chúng tôi</a></li>
                        <li><a href="#" class="footer-link">Dịch vụ</a></li>
                        <li><a href="#" class="footer-link">Phòng & Giá</a></li>
                        <li><a href="#" class="footer-link">Blog du lịch</a></li>
                        <li><a href="#" class="footer-link">Ưu đãi</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-2 col-6 mb-5 mb-lg-0">
                    <h5>Hỗ Trợ</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="footer-link">Hỏi đáp (FAQ)</a></li>
                        <li><a href="#" class="footer-link">Trung tâm hỗ trợ</a></li>
                        <li><a href="#" class="footer-link">Chính sách bảo mật</a></li>
                        <li><a href="#" class="footer-link">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <h5>Liên Hệ</h5>
                    <div class="contact-info-item">
                        <i class="bi bi-geo-alt"></i>
                        <span>123 Đường Ven Biển, Quận Ngũ Hành Sơn, Đà Nẵng, Việt Nam</span>
                    </div>
                    <div class="contact-info-item">
                        <i class="bi bi-telephone"></i>
                        <span>+84 123 456 789</span>
                    </div>
                    <div class="contact-info-item">
                        <i class="bi bi-envelope"></i>
                        <span>contact@luxuryhotel.com</span>
                    </div>
                    <div class="contact-info-item">
                        <i class="bi bi-clock"></i>
                        <span>Phục vụ 24/7</span>
                    </div>
                </div>
            </div>
            
            <hr>
            
            <div class="row align-items-center py-3">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="text-muted">&copy; 2026 <strong>Luxury Hotel</strong>. All rights reserved.</span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <small class="text-muted">Designed with <i class="bi bi-heart-fill text-danger mx-1"></i> by <strong>NVTLong</strong></small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(window).scroll(function() {
            if ($(this).scrollTop() > 50) {
                $('.navbar').addClass('scrolled');
            } else {
                $('.navbar').removeClass('scrolled');
            }
        });
        
        // Ensure navbar-solid is maintained on scroll for non-home pages
        $(document).ready(function() {
            if ($('.navbar').hasClass('navbar-solid')) {
                // Potential extra logic if needed
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
