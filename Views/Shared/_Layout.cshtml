<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Luxury Hotel</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- Icons & Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        :root {
            --primary-navy: #0f172a;
            --accent-gold: #fbbf24;
            --soft-white: #f8fafc;
            --text-muted: #64748b;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--primary-navy);
            background-color: #fff;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, .navbar-brand {
            font-family: 'Playfair Display', serif;
        }

        /* Navbar Styling */
        .navbar {
            padding: 1.5rem 0;
            transition: all 0.4s ease;
            background: transparent !important;
            border-bottom: 1px solid rgba(255,255,255,0.1) !important;
        }

        .navbar.scrolled, .navbar.navbar-solid {
            padding: 1rem 0;
            background: rgba(15, 23, 42, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            border-bottom: 1px solid rgba(255,255,255,0.05) !important;
        }

        .navbar-brand {
            font-size: 1.6rem;
            font-weight: 700;
            color: #fff !important;
            letter-spacing: 1px;
        }

        .nav-link {
            color: rgba(255,255,255,0.8) !important;
            font-weight: 400;
            margin: 0 1rem;
            transition: color 0.3s;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1.5px;
        }

        .nav-link:hover {
            color: var(--accent-gold) !important;
        }

        .icon-btn {
            width: 45px;
            height: 45px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: #fff;
            font-size: 1.3rem;
            transition: all 0.3s ease;
            text-decoration: none;
            background: transparent;
            cursor: pointer;
        }
        
        .icon-btn:hover {
            background: var(--accent-gold);
            border-color: var(--accent-gold);
            color: var(--primary-navy);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(251, 191, 36, 0.4);
        }

        /* Footer */
        footer {
            background: var(--primary-navy);
            color: #ccc;
            padding: 5rem 0 2rem;
            font-size: 0.9rem;
        }

        footer h5 {
            color: #fff;
            margin-bottom: 1.5rem;
            font-size: 1.2rem;
        }

        footer hr {
            border-color: rgba(255,255,255,0.1);
        }

        .social-link {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,0.2);
            margin-right: 0.5rem;
            color: #fff;
            transition: 0.3s;
        }

        .social-link:hover {
            background: var(--accent-gold);
            border-color: var(--accent-gold);
            color: var(--primary-navy);
        }

        /* User Dropdown Profile */
        .user-dropdown .dropdown-toggle::after {
            display: none; /* Hide default arrow */
        }
        .user-dropdown .dropdown-menu {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 0.5rem;
            margin-top: 1.2rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            min-width: 220px;
            border-top: 2px solid var(--accent-gold);
        }
        .user-dropdown .dropdown-item {
            color: rgba(255, 255, 255, 0.8) !important;
            padding: 0.7rem 1.2rem;
            border-radius: 8px;
            transition: all 0.2s;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
        }
        .user-dropdown .dropdown-item:hover {
            background: rgba(251, 191, 36, 0.1);
            color: var(--accent-gold) !important;
            transform: translateX(5px);
        }
        .user-dropdown .dropdown-divider {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin: 0.5rem 0;
        }
        .user-dropdown .dropdown-header {
            color: var(--accent-gold);
            font-weight: 600;
            padding: 0.8rem 1.2rem;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-family: 'Inter', sans-serif;
        }
        .user-dropdown .dropdown-item i {
            font-size: 1.1rem;
            margin-right: 0.8rem;
        }
    </style>
</head>
<body>
    <header>
        @{
            var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && 
                         ViewContext.RouteData.Values["action"]?.ToString() == "Index";
        }
        <nav class="navbar navbar-expand-lg fixed-top @(isHome ? "" : "navbar-solid")">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    LUXURY <span style="color: var(--accent-gold)">HOTEL</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="bi bi-list text-white fs-2"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @await Component.InvokeAsync("RoomTypeMenu")
                        <li class="nav-item">
                            <a class="nav-link" href="#cuisine">Ẩm thực</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#offers">Ưu đãi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#amenities">Tiện nghi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contact">Liên Hệ</a>
                        </li>
                    </ul>
                    <div class="auth-user-info d-flex align-items-center gap-2 flex-nowrap ms-lg-3">
                        @if (Context.Session.GetString("CustomerEmail") != null)
                        {
                            <div class="dropdown user-dropdown">
                                <button class="icon-btn dropdown-toggle p-0 overflow-hidden" type="button" id="userProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Tài khoản">
                                    @{
                                        var avatarUrl = Context.Session.GetString("CustomerAvatar");
                                    }
                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl" style="width: 100%; height: 100%; object-fit: cover;" alt="Avatar" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle"></i>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userProfileDropdown">
                                    <li><h6 class="dropdown-header">Xin chào, @Context.Session.GetString("CustomerName")</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-badge"></i> Thông tin khách hàng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="BookingHistory">
                                            <i class="bi bi-journal-text"></i> Lịch sử đặt phòng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                            <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="icon-btn" asp-controller="Account" asp-action="Login" title="Đăng nhập">
                                <i class="bi bi-person"></i>
                            </a>
                            <a class="icon-btn" asp-controller="Account" asp-action="Register" title="Đăng ký">
                                <i class="bi bi-person-plus"></i>
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer id="contact">
        <div class="container text-center text-md-start">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="navbar-brand m-0 mb-3">LUXURY HOTEL</h5>
                    <p>Khám phá sự giao thoa hoàn hảo giữa thiết kế hiện đại và sự hiếu khách đẳng cấp thế giới. Mỗi khoảnh khắc tại đây là một trải nghiệm không thể quên.</p>
                    <div class="mt-3">
                        <a href="#" class="social-link"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-link"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-link"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                <div class="col-md-2 mb-4">
                    <h5 id="offers">Liên kết</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Về chúng tôi</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Dịch vụ</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Blog du lịch</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Ưu đãi</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h5>Hỗ trợ</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Hỏi đáp (FAQ)</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Chính sách bảo mật</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Liên hệ</h5>
                    <p class="mb-2 text-muted"><i class="bi bi-geo-alt me-2"></i> 123 Đường Ven Biển, Đà Nẵng, Việt Nam</p>
                    <p class="mb-2 text-muted"><i class="bi bi-telephone me-2"></i> +84 123 456 789</p>
                    <p class="mb-2 text-muted"><i class="bi bi-envelope me-2"></i> contact@luxuryhotel.com</p>
                </div>
            </div>
            <hr>
            <div class="text-center pt-3">
                <small class="text-muted">&copy; 2026 - Luxury Hotel. Desinged with <i class="bi bi-heart-fill text-danger"></i></small>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(window).scroll(function() {
            if ($(this).scrollTop() > 50) {
                $('.navbar').addClass('scrolled');
            } else {
                $('.navbar').removeClass('scrolled');
            }
        });
        
        // Ensure navbar-solid is maintained on scroll for non-home pages
        $(document).ready(function() {
            if ($('.navbar').hasClass('navbar-solid')) {
                // Potential extra logic if needed
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
