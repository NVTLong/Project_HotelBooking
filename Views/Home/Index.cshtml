@section Scripts {
    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            var swiper = new Swiper('.offers-swiper', {
                effect: 'coverflow',
                grabCursor: true,
                centeredSlides: true,
                slidesPerView: 'auto',
                coverflowEffect: {
                    rotate: 30, // Điều chỉnh độ nghiêng
                    stretch: 0,
                    depth: 250, // Khoảng cách 3D
                    modifier: 1,
                    slideShadows: true,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true
                },
                loop: true,
                autoplay: {
                    delay: 3500,
                    disableOnInteraction: false,
                }
            });


            $('#checkInDate').on('change', function() {
                var checkInVal = $(this).val();
                if (checkInVal) {
                    var checkInDate = new Date(checkInVal);
                    var nextDay = new Date(checkInDate);
                    nextDay.setDate(checkInDate.getDate() + 1);
                    
                    var year = nextDay.getFullYear();
                    var month = String(nextDay.getMonth() + 1).padStart(2, '0');
                    var day = String(nextDay.getDate()).padStart(2, '0');
                    var minCheckOut = year + '-' + month + '-' + day;
                    
                    $('#checkOutDate').attr('min', minCheckOut);
                    
                    var checkOutVal = $('#checkOutDate').val();
                    if (checkOutVal) {
                        var currentCheckOut = new Date(checkOutVal);
                        if (currentCheckOut <= checkInDate) {
                            $('#checkOutDate').val(minCheckOut);
                        }
                    } else {
                        $('#checkOutDate').val(minCheckOut);
                    }
                }
            });
        });
    </script>
}
