@model Project_HotelBooking.Application.DTOs.RoomType.RoomTypeDto

@{
    ViewData["Title"] = $"Hạng phòng {Model.Name}";
}

<!-- Swiper.js CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style>
    .details-hero {
        height: 60vh;
        min-height: 400px;
        position: relative;
        overflow: hidden;
    }

    .details-hero img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .details-hero::after {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(to top, rgba(15, 23, 42, 0.8) 0%, transparent 50%);
    }

    .hero-text {
        position: absolute;
        bottom: 40px;
        left: 0;
        width: 100%;
        color: #fff;
        z-index: 2;
    }

    .amenity-badge {
        background: #f1f5f9;
        color: var(--primary-navy);
        padding: 10px 20px;
        border-radius: 12px;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-right: 10px;
        margin-bottom: 10px;
        transition: all 0.3s;
    }

    .amenity-badge:hover {
        background: var(--accent-gold);
        transform: translateY(-3px);
    }

    .booking-sidebar {
        background: #fff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        position: sticky;
        top: 100px;
    }

    .price-large {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--primary-navy);
        margin-bottom: 5px;
    }

    .btn-book-now {
        background: var(--primary-navy);
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 15px;
        font-weight: 700;
        width: 100%;
        margin-top: 20px;
        transition: all 0.3s;
    }

    .btn-book-now:hover {
        background: var(--accent-gold);
        color: var(--primary-navy);
        transform: scale(1.02);
    }

    .thumbnail-gallery {
        display: flex;
        gap: 10px;
        margin-top: 20px;
        overflow-x: auto;
        padding-bottom: 10px;
    }

    .thumbnail-img {
        width: 100px;
        height: 70px;
        border-radius: 8px;
        object-fit: cover;
        cursor: pointer;
        opacity: 0.6;
        transition: 0.3s;
    }

    .thumbnail-img.active, .thumbnail-img:hover {
        opacity: 1;
        border: 2px solid var(--accent-gold);
    }

    .suggestion-card-item {
        border: 1px solid #f1f5f9;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    
    .suggestion-card-item:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
    }

    .swiper-button-prev-custom, .swiper-button-next-custom {
        width: 40px;
        height: 40px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
        color: var(--primary-navy);
        z-index: 10;
    }

    .swiper-button-prev-custom:hover, .swiper-button-next-custom:hover {
        background: var(--primary-navy);
        color: #fff;
        border-color: var(--primary-navy);
    }

    .swiper-pagination-bullet-active {
        background: var(--accent-gold) !important;
    }
</style>

<div class="details-hero">
    @{
        var mainImg = Model.RoomTypeImages?.FirstOrDefault(x => x.IsPrimary)?.ImageUrl 
                   ?? Model.RoomTypeImages?.FirstOrDefault()?.ImageUrl
                   ?? "https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=1920&auto=format&fit=crop";
    }
    <img id="mainImage" src="@mainImg" alt="Hạng phòng @Model.Name">
    <div class="hero-text">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Hạng phòng @Model.Name</li>
                </ol>
            </nav>
            <h1 class="display-4 fw-bold" style="font-family: 'Playfair Display', serif;">Hạng phòng @Model.Name</h1>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <div class="thumbnail-gallery mb-5">
                @if (Model.RoomTypeImages != null && Model.RoomTypeImages.Any())
                {
                    foreach (var img in Model.RoomTypeImages)
                    {
                        <img src="@img.ImageUrl" class="thumbnail-img @(img.IsPrimary ? "active" : "")" onclick="document.getElementById('mainImage').src='@img.ImageUrl'; $('.thumbnail-img').removeClass('active'); $(this).addClass('active');" alt="Gallery">
                    }
                }
            </div>

            <h3 class="fw-bold mb-4" style="font-family: 'Playfair Display', serif;">Mô tả hạng phòng</h3>
            <p class="fs-5 text-muted mb-5 fw-light" style="line-height: 1.8;">@Model.Description</p>

            <h3 class="fw-bold mb-4" style="font-family: 'Playfair Display', serif;">Tiện nghi đặc sắc</h3>
            <div class="mb-5">
                @if (Model.Amenities != null && Model.Amenities.Any())
                {
                    foreach (var amenity in Model.Amenities)
                    {
                        <div class="amenity-badge"><i class="bi bi-check2-circle fs-5"></i> @amenity</div>
                    }
                }
                else
                {
                    <p class="text-muted">Đang cập nhật các tiện ích cho hạng phòng này...</p>
                }
            </div>

            @if (Model.RoomTypeImages != null && Model.RoomTypeImages.Count > 1)
            {
                <h3 class="fw-bold mb-4" style="font-family: 'Playfair Display', serif;">Bộ sưu tập hình ảnh</h3>
                <div class="row g-3">
                    @foreach (var img in Model.RoomTypeImages.Skip(1))
                    {
                        <div class="col-md-6">
                            <img src="@img.ImageUrl" class="img-fluid rounded-4 shadow-sm" alt="Gallery Large" style="height: 250px; width: 100%; object-fit: cover;">
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="booking-sidebar">
                <p class="text-muted small text-uppercase fw-bold mb-1">Giá cơ bản từ</p>
                <div class="price-large">@Model.BasePrice.ToString("N0")đ <span class="fs-6 text-muted fw-normal">/ đêm</span></div>
                <hr class="my-4">
                
                <div class="mb-4">
                    <label class="small fw-bold text-uppercase text-muted mb-2 d-block">Sức chứa tối đa</label>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-people-fill fs-4 text-warning"></i>
                        <span class="fw-bold fs-5">@Model.Capacity người lớn</span>
                    </div>
                </div>

                <div class="alert alert-info border-0 rounded-4 p-3 small">
                    <i class="bi bi-info-circle-fill me-2"></i> Giá có thể thay đổi tùy thuộc vào thời điểm đặt và vị trí phòng cụ thể.
                </div>

                <a href="/Room/Index?roomTypeId=@Model.Id" class="btn btn-book-now">
                    XEM DANH SÁCH PHÒNG <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Other Room Types Suggestions -->
    @{
        var otherRoomTypes = ViewBag.OtherRoomTypes as IEnumerable<Project_HotelBooking.Application.DTOs.RoomType.RoomTypeDto>;
    }

    @if (otherRoomTypes != null && otherRoomTypes.Any())
    {
        <div class="mt-5 pt-5 pb-5 border-top position-relative">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h6 class="text-uppercase fw-bold text-warning mb-2" style="letter-spacing: 2px; font-size: 0.8rem;">Đa dạng lựa chọn</h6>
                    <h2 class="fw-bold m-0" style="font-family: 'Playfair Display', serif;">Khám phá các loại phòng khác</h2>
                </div>
                <div class="d-flex gap-2">
                    <div class="swiper-button-prev-custom other-types-prev"><i class="bi bi-chevron-left"></i></div>
                    <div class="swiper-button-next-custom other-types-next"><i class="bi bi-chevron-right"></i></div>
                </div>
            </div>

            <div class="swiper otherTypesSwiper">
                <div class="swiper-wrapper mb-5">
                    @foreach (var rt in otherRoomTypes)
                    {
                        <div class="swiper-slide">
                            <div class="room-card suggestion-card-item h-100">
                                <div class="room-image" style="height: 200px; position: relative; overflow: hidden;">
                                    @{
                                        var rtImg = rt.RoomTypeImages?.FirstOrDefault(x => x.IsPrimary)?.ImageUrl 
                                                 ?? rt.RoomTypeImages?.FirstOrDefault()?.ImageUrl
                                                 ?? "https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=800&auto=format&fit=crop";
                                    }
                                    <img src="@rtImg" class="w-100 h-100 object-fit-cover transition-transform" style="transition: transform 0.5s ease;" alt="@rt.Name">
                                    <div class="price-tag" style="position: absolute; bottom: 15px; right: 15px; background: var(--accent-gold); color: var(--primary-navy); padding: 5px 12px; border-radius: 6px; font-weight: 700; font-size: 0.9rem;">
                                        @rt.BasePrice.ToString("N0")đ
                                    </div>
                                </div>
                                <div class="room-content p-4">
                                    <h5 class="fw-bold mb-1">@rt.Name</h5>
                                    <div class="text-muted small mb-3">
                                        <i class="bi bi-people me-1 text-warning"></i> Sức chứa: @rt.Capacity người
                                    </div>
                                    <a asp-action="Details" asp-route-id="@rt.Id" class="btn btn-details w-100">KHÁM PHÁ NGAY <i class="bi bi-arrow-right ms-2"></i></a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="swiper-pagination other-types-pagination"></div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <!-- Swiper.js JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            const otherTypesSwiper = new Swiper('.otherTypesSwiper', {
                slidesPerView: 1,
                spaceBetween: 24,
                navigation: {
                    nextEl: '.other-types-next',
                    prevEl: '.other-types-prev',
                },
                pagination: {
                    el: '.other-types-pagination',
                    clickable: true,
                },
                breakpoints: {
                    768: { slidesPerView: 2 },
                    1024: { slidesPerView: 3 }
                }
            });
        });
    </script>
}
