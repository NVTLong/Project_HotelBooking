@model IEnumerable<Project_HotelBooking.Application.DTOs.Room.RoomDto>

@{
    ViewData["Title"] = "Danh sách phòng trống";
    var checkIn = ViewData["CheckIn"]?.ToString();
    var checkOut = ViewData["CheckOut"]?.ToString();
    var adults = ViewData["Adults"];
    var children = ViewData["Children"];
}

<style>
    .rooms-header {
        background: linear-gradient(rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.7)), url('https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=1920&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        padding: 120px 0 60px;
        color: #fff;
        text-align: center;
    }

    .search-summary {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50px;
        padding: 12px 30px;
        display: inline-flex;
        align-items: center;
        gap: 20px;
        margin-top: 20px;
        font-size: 0.9rem;
    }

    .room-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        height: 100%;
        border: none;
        display: flex;
        flex-direction: column;
    }

    .room-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .room-image {
        height: 250px;
        position: relative;
        overflow: hidden;
    }

    .room-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .room-card:hover .room-image img {
        transform: scale(1.1);
    }

    .price-tag {
        position: absolute;
        bottom: 20px;
        right: 20px;
        background: var(--accent-gold);
        color: var(--primary-navy);
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 700;
        z-index: 2;
    }

    .room-content {
        padding: 25px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .room-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 10px;
        color: var(--primary-navy);
    }

    .room-features {
        list-style: none;
        padding: 0;
        margin-bottom: 20px;
        display: flex;
        gap: 15px;
        color: #64748b;
        font-size: 0.85rem;
    }

    .room-features i {
        color: var(--accent-gold);
        margin-right: 5px;
    }

    .btn-details {
        background: transparent;
        color: var(--primary-navy);
        border: 1px solid var(--primary-navy);
        border-radius: 10px;
        padding: 10px 0;
        font-weight: 600;
        transition: all 0.3s;
        width: 100%;
        margin-top: auto;
    }

    .btn-details:hover {
        background: var(--primary-navy);
        color: #fff;
    }

    .filter-section {
        background: #fff;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        margin-top: -50px;
        position: relative;
        z-index: 5;
    }
</style>

<div class="rooms-header">
    <div class="container">
        <h1 class="display-4 fw-bold" style="font-family: 'Playfair Display', serif;">Kết Quả Tìm Kiếm</h1>
        <div class="search-summary">
            <span><i class="bi bi-calendar-event me-2"></i> @checkIn - @checkOut</span>
            <span><i class="bi bi-people me-2"></i> @adults Người lớn, @children Trẻ em</span>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="filter-section mb-5">
        <form action="/Room/Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase">Ngày đến</label>
                <input type="date" name="checkIn" value="@checkIn" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase">Ngày đi</label>
                <input type="date" name="checkOut" value="@checkOut" class="form-control">
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase">Người lớn</label>
                <input type="number" name="adults" value="@adults" min="1" class="form-control">
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase">Trẻ em</label>
                <input type="number" name="children" value="@children" min="0" class="form-control">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-warning w-100 py-2 fw-bold text-uppercase" style="background: var(--accent-gold); border: none;">Tìm kiếm</button>
            </div>
        </form>
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
                <h3 class="fw-bold">Rất tiếc, không tìm thấy phòng!</h3>
                <p class="text-muted">Vui lòng thử chọn lại ngày khác hoặc thay đổi số lượng khách.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="room-card">
                        <div class="room-image">
                            @{
                                var primaryImage = item.RoomImages?.FirstOrDefault(x => x.IsPrimary)?.ImageUrl 
                                               ?? item.RoomImages?.FirstOrDefault()?.ImageUrl
                                               ?? "https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=800&auto=format&fit=crop";
                            }
                            <img src="@primaryImage" alt="Phòng @item.RoomNumber">
                            <div class="price-tag">@item.Price.ToString("N0")đ</div>
                        </div>
                        <div class="room-content">
                            <h3 class="room-title">Phòng @item.RoomNumber (@item.RoomTypeName)</h3>
                            <ul class="room-features">
                                <li><i class="bi bi-people"></i>@item.RoomTypeName</li>
                                <li><i class="bi bi-arrows-fullscreen"></i>@item.FloorName</li>
                                <li><i class="bi bi-wifi"></i> Wifi</li>
                            </ul>
                            <p class="text-muted small mb-4 opacity-75">
                                Trạng thái: Sẵn sàng phục vụ. Tiện nghi đầy đủ, không gian sang trọng hiện đại.
                            </p>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details">XEM CHI TIẾT <i class="bi bi-arrow-right ms-2"></i></a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
