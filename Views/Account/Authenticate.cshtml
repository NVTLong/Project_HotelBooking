@using Microsoft.AspNetCore.Http
@model Project_HotelBooking.Models.ViewModels.AuthViewModel
@{
    ViewData["Title"] = "Xác thực";
    Layout = "_AuthLayout";
}

<style>
    .auth-container {
        background-color: #fff;
        border-radius: 20px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
        position: relative;
        overflow: hidden;
        width: 1000px;
        max-width: 100%;
        min-height: 650px;
        transition: all 0.6s ease-in-out;
    }

    .form-container {
        position: absolute;
        top: 0;
        height: 100%;
        transition: all 0.6s ease-in-out;
    }

    .sign-in-container {
        left: 0;
        width: 50%;
        z-index: 2;
    }

    .sign-up-container {
        left: 0;
        width: 50%;
        opacity: 0;
        z-index: 1;
    }

    .auth-container.right-panel-active .sign-in-container {
        transform: translateX(100%);
    }

    .auth-container.right-panel-active .sign-up-container {
        transform: translateX(100%);
        opacity: 1;
        z-index: 5;
        animation: show 0.6s;
    }

    @@keyframes show {
        0%, 49.99% { opacity: 0; z-index: 1; }
        50%, 100% { opacity: 1; z-index: 5; }
    }

    .overlay-container {
        position: absolute;
        top: 0;
        left: 50%;
        width: 50%;
        height: 100%;
        overflow: hidden;
        transition: transform 0.6s ease-in-out;
        z-index: 100;
    }

    .auth-container.right-panel-active .overlay-container {
        transform: translateX(-100%);
    }

    .overlay {
        background: var(--teal-gradient);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: 0 0;
        color: #FFFFFF;
        position: relative;
        left: -100%;
        height: 100%;
        width: 200%;
        transform: translateX(0);
        transition: transform 0.6s ease-in-out;
    }

    .auth-container.right-panel-active .overlay {
        transform: translateX(50%);
    }

    .overlay-panel {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 0 40px;
        text-align: center;
        top: 0;
        height: 100%;
        width: 50%;
        transform: translateX(0);
        transition: transform 0.6s ease-in-out;
    }

    .overlay-left {
        transform: translateX(-20%);
    }

    .auth-container.right-panel-active .overlay-left {
        transform: translateX(0);
    }

    .overlay-right {
        right: 0;
        transform: translateX(0);
    }

    .auth-container.right-panel-active .overlay-right {
        transform: translateX(20%);
    }

    /* Form Styles */
    form {
        background-color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 0 50px;
        height: 100%;
        text-align: center;
    }

    .auth-title {
        font-weight: bold;
        margin-bottom: 1.5rem;
        color: var(--primary-navy);
    }

    .form-group-custom {
        width: 100%;
        margin-bottom: 0.8rem;
        text-align: left;
    }

    .form-group-custom label {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 0.3rem;
        display: block;
    }

    .form-control-custom {
        background-color: #f1f5f9;
        border: 2px solid transparent;
        border-radius: 10px;
        padding: 12px 15px;
        width: 100%;
        outline: none;
        transition: all 0.3s;
    }

    .form-control-custom:focus {
        border-color: var(--soft-teal);
        background-color: #fff;
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.1);
    }

    .btn-auth-primary {
        border-radius: 12px;
        border: none;
        background: var(--teal-gradient);
        color: #FFFFFF;
        font-size: 12px;
        font-weight: bold;
        padding: 15px 45px;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: transform 80ms ease-in;
        margin-top: 1rem;
        cursor: pointer;
    }

    .btn-auth-primary:active {
        transform: scale(0.95);
    }

    .btn-auth-ghost {
        background-color: transparent;
        border: 2px solid #FFFFFF;
        border-radius: 12px;
        color: #FFFFFF;
        font-size: 12px;
        font-weight: bold;
        padding: 12px 45px;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: all 0.3s;
        margin-top: 1rem;
        cursor: pointer;
    }

    .btn-auth-ghost:hover {
        background-color: #fff;
        color: #065f46;
    }

    .validation-error {
        color: #ef4444;
        font-size: 0.75rem;
        margin-top: 0.2rem;
    }

    @@media (max-width: 768px) {
        .auth-container {
            width: 100%;
            border-radius: 0;
            min-height: 100vh;
        }
        .overlay-container {
            display: none;
        }
        .sign-in-container, .sign-up-container {
            width: 100%;
            position: relative;
            transform: none !important;
            opacity: 1 !important;
            z-index: 1 !important;
            height: auto;
            display: none;
        }
        .auth-container.right-panel-active .sign-up-container {
            display: block;
        }
        .auth-container:not(.right-panel-active) .sign-in-container {
            display: block;
        }
        form {
            padding: 50px 20px;
        }
        .mobile-toggle {
            display: block;
            margin-top: 2rem;
            color: var(--soft-teal);
            font-weight: 600;
            cursor: pointer;
        }
    }
    
    .mobile-toggle {
        display: none;
    }

    .back-to-home {
        position: absolute;
        top: 20px;
        left: 30px;
        z-index: 200;
        color: var(--primary-navy);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .back-to-home:hover {
        color: var(--soft-teal);
        transform: translateX(-5px);
    }

    .auth-container.right-panel-active .back-to-home {
        color: #fff;
    }
</style>

<div class="auth-container @(Model.ActiveMode == "register" ? "right-panel-active" : "")" id="auth-container">
    <a asp-controller="Home" asp-action="Index" class="back-to-home"><i class="bi bi-arrow-left"></i> Quay lại trang chủ</a>
    
    <!-- Sign Up Form -->
    <div class="form-container sign-up-container">
        <form asp-action="Register" asp-controller="Account" method="post">
            <h1 class="auth-title">Tạo Tài Khoản</h1>
            <div asp-validation-summary="ModelOnly" class="validation-error mb-3"></div>
            
            <div class="form-group-custom">
                <label asp-for="Register.FullName">Họ và tên</label>
                <input asp-for="Register.FullName" class="form-control-custom" placeholder="Nguyễn Văn A" />
                <span asp-validation-for="Register.FullName" class="validation-error"></span>
            </div>

            <div class="row w-100 m-0">
                <div class="col-6 p-1">
                    <div class="form-group-custom">
                        <label asp-for="Register.Email">Email</label>
                        <input asp-for="Register.Email" class="form-control-custom" placeholder="email@@example.com" />
                        <span asp-validation-for="Register.Email" class="validation-error"></span>
                    </div>
                </div>
                <div class="col-6 p-1">
                    <div class="form-group-custom">
                        <label asp-for="Register.PhoneNumber">SĐT</label>
                        <input asp-for="Register.PhoneNumber" class="form-control-custom" placeholder="090..." />
                        <span asp-validation-for="Register.PhoneNumber" class="validation-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-group-custom">
                <label asp-for="Register.Password">Mật khẩu</label>
                <input asp-for="Register.Password" type="password" class="form-control-custom" placeholder="••••••••" />
                <span asp-validation-for="Register.Password" class="validation-error"></span>
            </div>

            <div class="form-group-custom">
                <label asp-for="Register.ConfirmPassword">Xác nhận</label>
                <input asp-for="Register.ConfirmPassword" type="password" class="form-control-custom" placeholder="••••••••" />
                <span asp-validation-for="Register.ConfirmPassword" class="validation-error"></span>
            </div>

            <button type="submit" class="btn-auth-primary">Đăng Ký</button>
            <div class="mobile-toggle" onclick="togglePanel(false)">Đã có tài khoản? Đăng nhập</div>
        </form>
    </div>

    <!-- Sign In Form -->
    <div class="form-container sign-in-container">
        <form asp-action="Login" asp-controller="Account" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <h1 class="auth-title">Đăng Nhập</h1>
            <div asp-validation-summary="ModelOnly" class="validation-error mb-3"></div>
            
            <div class="form-group-custom">
                <label asp-for="Login.Email">Email</label>
                <input asp-for="Login.Email" class="form-control-custom" placeholder="nhap@@example.com" />
                <span asp-validation-for="Login.Email" class="validation-error"></span>
            </div>

            <div class="form-group-custom">
                <label asp-for="Login.Password">Mật khẩu</label>
                <input asp-for="Login.Password" type="password" class="form-control-custom" placeholder="••••••••" />
                <span asp-validation-for="Login.Password" class="validation-error"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center w-100 mb-4 small">
                <div class="form-check">
                    <input asp-for="Login.RememberMe" class="form-check-input" />
                    <label class="form-check-label opacity-75" asp-for="Login.RememberMe">Ghi nhớ</label>
                </div>
                <a href="#" class="text-muted text-decoration-none">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-auth-primary">Đăng Nhập</button>
            <div class="mobile-toggle" onclick="togglePanel(true)">Chưa có tài khoản? Đăng ký</div>
        </form>
    </div>

    <!-- Overlay -->
    <div class="overlay-container">
        <div class="overlay">
            <div class="overlay-panel overlay-left">
                <h1 class="mb-3 text-white">Chào Mừng Trở Lại!</h1>
                <p class="mb-4">Để giữ kết nối với chúng tôi, vui lòng đăng nhập bằng thông tin cá nhân của bạn</p>
                <button class="btn-auth-ghost" id="signIn" onclick="togglePanel(false)">Đăng Nhập</button>
            </div>
            <div class="overlay-panel overlay-right">
                <h1 class="mb-3 text-white">Chào Bạn!</h1>
                <p class="mb-4">Nhập thông tin cá nhân của bạn và bắt đầu hành trình cùng Luxury Hotel</p>
                <button class="btn-auth-ghost" id="signUp" onclick="togglePanel(true)">Đăng Ký</button>
            </div>
        </div>
    </div>
</div>

<script>
    const container = document.getElementById('auth-container');

    function togglePanel(isRegister) {
        if (isRegister) {
            container.classList.add("right-panel-active");
        } else {
            container.classList.remove("right-panel-active");
        }
    }
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
