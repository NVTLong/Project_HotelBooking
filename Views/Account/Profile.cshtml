@model Project_HotelBooking.Application.DTOs.Customer.CustomerDto
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container py-5" style="margin-top: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px);">
                <div class="card-header bg-dark text-white p-4 border-0">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-person-fill fs-2 text-dark"></i>
                        </div>
                        <div>
                            <h3 class="m-0 font-playfair">Thông tin cá nhân</h3>
                            <p class="m-0 small text-light opacity-75">Quản lý thông tin tài khoản của bạn</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-4">
                            <!-- Avatar Upload -->
                            <div class="col-12 text-center mb-4">
                                <div class="position-relative d-inline-block">
                                    <img id="avatarPreview" src="@(!string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "/images/default-user.png")" 
                                         class="rounded-circle shadow-sm border border-3 border-warning" 
                                         style="width: 150px; height: 150px; object-fit: cover;" alt="Avatar" />
                                    <label for="AvatarFile" class="btn btn-warning rounded-circle position-absolute bottom-0 end-0 p-2 shadow-sm" style="cursor: pointer;">
                                        <i class="bi bi-camera-fill text-dark"></i>
                                    </label>
                                    <input type="file" name="AvatarFile" id="AvatarFile" class="d-none" accept="image/*" onchange="previewImage(this)" />
                                </div>
                                <p class="text-muted small mt-2">Nhấp vào máy ảnh để đổi ảnh đại diện</p>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-bold text-muted small text-uppercase">Họ và tên</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-person"></i></span>
                                    <input asp-for="FullName" class="form-control bg-light border-0 p-3" placeholder="Nhập họ tên" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold text-muted small text-uppercase">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control bg-light border-0 p-3" readonly />
                                </div>
                                <small class="text-muted mt-1 d-block italic">Email không thể thay đổi</small>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-muted small text-uppercase">Số điện thoại</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control bg-light border-0 p-3" placeholder="Nhập số điện thoại" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="IdentityNumber" class="form-label fw-bold text-muted small text-uppercase">Số định danh (CCCD/CMT)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-card-text"></i></span>
                                    <input asp-for="IdentityNumber" class="form-control bg-light border-0 p-3" placeholder="Nhập số CCCD/CMT" />
                                </div>
                                <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-bold text-muted small text-uppercase">Địa chỉ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Address" class="form-control bg-light border-0 p-3" placeholder="Nhập địa chỉ" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mt-5">
                                <button type="submit" class="btn btn-dark w-100 p-3 fw-bold text-uppercase shadow-sm" style="border-radius: 10px; letter-spacing: 1px;">
                                    Lưu thay đổi
                                </button>
                                <a asp-controller="Home" asp-action="Index" class="btn btn-link w-100 mt-2 text-muted text-decoration-none small">Quay lại trang chủ</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
